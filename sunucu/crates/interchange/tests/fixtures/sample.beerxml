<?xml version="1.0" encoding="UTF-8"?>
<RECIPES>
  <RECIPE>
    <VERSION>1</VERSION>
    <NAME>Test Pale &amp; Hoppy</NAME>
    <TYPE>All Grain</TYPE>
    <BREWER>GRISTORA Test Brewer</BREWER>
    <BATCH_SIZE>20</BATCH_SIZE>
    <BOIL_SIZE>25</BOIL_SIZE>
    <BOIL_TIME>60</BOIL_TIME>
    <EFFICIENCY>72</EFFICIENCY>
    <IBU_METHOD>Tinseth</IBU_METHOD>
    <OG>1.052</OG>
    <FG>1.011</FG>
    <IBU>38</IBU>
    <EST_COLOR>7.5</EST_COLOR>
    <ABV>5.4</ABV>
    <STYLE>
      <VERSION>1</VERSION><NAME>American Pale Ale</NAME><CATEGORY>American Ale</CATEGORY>
      <CATEGORY_NUMBER>18</CATEGORY_NUMBER><STYLE_LETTER>A</STYLE_LETTER><STYLE_GUIDE>BJCP</STYLE_GUIDE>
      <TYPE>Ale</TYPE><OG_MIN>1.045</OG_MIN><OG_MAX>1.060</OG_MAX>
      <FG_MIN>1.008</FG_MIN><FG_MAX>1.015</FG_MAX><IBU_MIN>30</IBU_MIN><IBU_MAX>50</IBU_MAX>
      <COLOR_MIN>5</COLOR_MIN><COLOR_MAX>12</COLOR_MAX>
    </STYLE>
    <EQUIPMENT>
      <VERSION>1</VERSION><NAME>Test Kettle 30 L</NAME>
      <BOIL_SIZE>25</BOIL_SIZE><BATCH_SIZE>20</BATCH_SIZE><BOIL_TIME>60</BOIL_TIME>
      <EFFICIENCY>72</EFFICIENCY><TRUB_CHILLER_LOSS>1.5</TRUB_CHILLER_LOSS><EVAP_RATE>10</EVAP_RATE>
    </EQUIPMENT>
    <HOPS>
      <HOP><VERSION>1</VERSION><NAME>Test Hop A</NAME><ALPHA>12.5</ALPHA><AMOUNT>0.028</AMOUNT><USE>Boil</USE><TIME>60</TIME><FORM>Pellet</FORM></HOP>
      <HOP><VERSION>1</VERSION><NAME>Test Hop B</NAME><ALPHA>5.5</ALPHA><AMOUNT>0.05</AMOUNT><USE>Dry Hop</USE><TIME>4320</TIME><FORM>Pellet</FORM></HOP>
    </HOPS>
    <FERMENTABLES>
      <FERMENTABLE><VERSION>1</VERSION><NAME>Test Pale Malt</NAME><TYPE>Grain</TYPE><AMOUNT>4.5</AMOUNT><YIELD>80</YIELD><COLOR>2.5</COLOR></FERMENTABLE>
      <FERMENTABLE><VERSION>1</VERSION><NAME>Test Sugar</NAME><TYPE>Sugar</TYPE><AMOUNT>0.3</AMOUNT><YIELD>100</YIELD><COLOR>0</COLOR></FERMENTABLE>
    </FERMENTABLES>
    <MISCS>
      <MISC><VERSION>1</VERSION><NAME>Test Fining</NAME><TYPE>Fining</TYPE><USE>Boil</USE><TIME>15</TIME><AMOUNT>0.005</AMOUNT><AMOUNT_IS_WEIGHT>TRUE</AMOUNT_IS_WEIGHT></MISC>
    </MISCS>
    <YEASTS>
      <YEAST><VERSION>1</VERSION><NAME>Test Ale Yeast</NAME><TYPE>Ale</TYPE><FORM>Dry</FORM><AMOUNT>0.01</AMOUNT><AMOUNT_IS_WEIGHT>TRUE</AMOUNT_IS_WEIGHT><ATTENUATION>78</ATTENUATION></YEAST>
    </YEASTS>
    <MASH><VERSION>1</VERSION><NAME>Single</NAME><GRAIN_TEMP>20</GRAIN_TEMP><MASH_STEPS>
      <MASH_STEP><VERSION>1</VERSION><NAME>Saccharification</NAME><TYPE>Infusion</TYPE><INFUSE_AMOUNT>13</INFUSE_AMOUNT><STEP_TEMP>66</STEP_TEMP><STEP_TIME>60</STEP_TIME></MASH_STEP>
    </MASH_STEPS></MASH>
    <WATERS></WATERS>
  </RECIPE>
</RECIPES>
