# Isteğe bağlı: bu dosyayı .env olarak kopyalayıp değerleri değiştirin.
# Hepsinin compose.yaml içinde aynı varsayılanı vardır; .env şart değildir.
# Yalnız yerel geliştirme değerleri; gerçek gizli bilgi buraya yazılmaz.

POSTGRES_USER=demleme
POSTGRES_PASSWORD=demleme-yerel
POSTGRES_DB=demleme

# Ana makinede açılan portlar (yalnız 127.0.0.1)
API_PORT=8080
WORKER_PORT=8081
INGEST_PORT=8082
ENGINE_PORT=50051
POSTGRES_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
GITHUB_MOCK_PORT=8090
APNS_MOCK_PORT=8091

