# Isteğe bağlı: bu dosyayı .env olarak kopyalayıp değerleri değiştirin.
# Hepsinin compose.yaml içinde aynı varsayılanı vardır; .env şart değildir.
# Yalnız yerel geliştirme değerleri; gerçek gizli bilgi buraya yazılmaz.

POSTGRES_USER=demleme
POSTGRES_PASSWORD=demleme-yerel
POSTGRES_DB=demleme

# Ana makinede açılan portlar (yalnız 127.0.0.1)
API_PORT=8080
WORKER_PORT=8081
INGEST_PORT=8082
ENGINE_PORT=50051
POSTGRES_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
S3_PORT=8333
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
GITHUB_MOCK_PORT=8090
APNS_MOCK_PORT=8091
APPLE_MOCK_PORT=8092

# Apple Sign In token exchange (local mock by default; use real secrets only outside dev).
APPLE_TOKEN_URL=http://apple-mock:8080/auth/token
APPLE_REVOKE_URL=http://apple-mock:8080/auth/revoke
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Local-only default is supplied by compose; override with a secret-manager value when needed.
PROVIDER_TOKEN_KEY=ZGVtbGVtZS1sb2NhbC1wcm92aWRlci1rZXktMDAwMDE=

