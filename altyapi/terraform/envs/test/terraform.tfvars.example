# Kopyala: cp terraform.tfvars.example terraform.tfvars  (terraform.tfvars depoya girmez)
# Aşağıdaki değerler yer tutucudur; gerçek proje kimliğini yalnız yerel tfvars'a yaz.

project_id = "demleme-test-ornek" # yer tutucu
region     = "us-east4"            # İngiltere: "europe-west2" (ayrı durum öneki ile)

# Kontrol düzlemine erişecek ağlar (CI çıkış adresi, yönetici ağı). Zorunlu.
master_authorized_networks = [
  {
    cidr_block   = "203.0.113.0/24" # belge amaçlı örnek aralık
    display_name = "ci-ornek"
  },
]

# İsteğe bağlı:
# sql_iam_service_accounts = ["api@demleme-test-ornek.iam.gserviceaccount.com"]
# registry_writer_members  = ["serviceAccount:ci@demleme-test-ornek.iam.gserviceaccount.com"]
# storage_cors_origins     = ["https://app.example.com"]
