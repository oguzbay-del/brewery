{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gristora-agent-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TASK_STORE",
        "class_name": "TaskStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TaskStore"]
    }
  ]
}
