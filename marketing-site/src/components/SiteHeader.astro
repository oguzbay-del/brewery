---
// Shared header, Stitch nav set B. `current` marks the matching link with aria-current="page".
// `home` makes the wordmark an in-page link to #top (home page only).
interface Props {
  current?: "product" | "modules" | "breweries" | "homebrewers" | "pricing" | "how-it-works" | "principles" | "faq";
  home?: boolean;
  lang?: "en" | "tr";
}
const { current, home = false, lang = "en" } = Astro.props;
const base = import.meta.env.BASE_URL;
const tr = lang === "tr";
// Turkish preview: links stay inside /tr/. The EN link points to the same page in English.
const root = tr ? `${base}tr/` : base;
const pathWithoutBase = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname.replace(/^\\/+/, "");
const languageHref = tr
  ? Astro.url.pathname.replace(`${base}tr/`, base)
  : `${base}tr/${pathWithoutBase}`;
const linksEn = [
  { id: "product", href: `${base}features/`, label: "Product", mobile: "Product" },
  { id: "modules", href: `${base}modules/`, label: "Modules", mobile: "Modules" },
  { id: "breweries", href: `${base}breweries/`, label: "Breweries", mobile: "Breweries" },
  { id: "homebrewers", href: `${base}homebrewers/`, label: "Homebrewers", mobile: "Homebrewers" },
  { id: "pricing", href: `${base}pricing/`, label: "Pricing", mobile: "Pricing" },
  { id: "how-it-works", href: `${base}how-it-works/`, label: "How it works", mobile: "How it works" },
  { id: "principles", href: `${base}technical-principles/`, label: "Principles", mobile: "Technical principles" },
  { id: "faq", href: `${base}faq/`, label: "FAQ", mobile: "FAQ" },
];
const linksTr = [
  { id: "product", href: `${root}features/`, label: "Ürün", mobile: "Ürün" },
  { id: "modules", href: `${root}modules/`, label: "Modüller", mobile: "Modüller" },
  { id: "breweries", href: `${root}breweries/`, label: "Bira üreticileri", mobile: "Bira üreticileri" },
  { id: "homebrewers", href: `${root}homebrewers/`, label: "Ev biracıları", mobile: "Ev biracıları" },
  { id: "pricing", href: `${root}pricing/`, label: "Fiyatlandırma", mobile: "Fiyatlandırma" },
  { id: "how-it-works", href: `${root}how-it-works/`, label: "Nasıl çalışır", mobile: "Nasıl çalışır" },
  { id: "principles", href: `${root}technical-principles/`, label: "İlkeler", mobile: "Teknik ilkeler" },
  { id: "faq", href: `${root}faq/`, label: "SSS", mobile: "SSS" },
];
const links = tr ? linksTr : linksEn;
---
<header class="site-header" id={home ? "top" : undefined}>
  <a class="wordmark" href={home ? "#top" : root} aria-label={tr ? "GRISTORA ana sayfa" : "GRISTORA home"}><img class="brand-symbol" src={`${base}brand/gristora-symbol.svg`} alt="" aria-hidden="true" width="130" height="160" /><span class="wordmark-text">GRISTORA</span></a>
  <nav class="desktop-nav" aria-label={tr ? "Ana gezinme" : "Main navigation"}>
    {links.map((link) => <a href={link.href} aria-current={current === link.id ? "page" : undefined}>{link.label}</a>)}
  </nav>
  <a class="lang-switch" href={languageHref} hreflang={tr ? "en" : "tr"} lang={tr ? "en" : "tr"}>{tr ? "EN" : "TR"}</a>
  <a class="header-cta" href={`${root}breweries/`}>{tr ? "Bira üreticileri için" : "Explore breweries"} <span aria-hidden="true">↗</span></a>
  <details class="mobile-menu"><summary aria-label={tr ? "Gezinme menüsünü aç" : "Open navigation menu"}><span></span><span></span></summary><nav aria-label={tr ? "Mobil gezinme" : "Mobile navigation"}>{links.map((link) => <a href={link.href} aria-current={current === link.id ? "page" : undefined}>{link.mobile}</a>)}</nav></details>
</header>
