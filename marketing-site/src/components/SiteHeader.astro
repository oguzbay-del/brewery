---
// Shared header, Stitch nav set B. `current` marks the matching link with aria-current="page".
// `home` makes the wordmark an in-page link to #top (home page only).
interface Props {
  current?: "product" | "modules" | "breweries" | "homebrewers" | "pricing" | "how-it-works" | "principles" | "faq";
  home?: boolean;
  alternatePath?: string;
  lang?: "en" | "tr";
}
const { current, home = false, lang = "en", alternatePath } = Astro.props;
const base = import.meta.env.BASE_URL;
const tr = lang === "tr";
// Turkish preview: links stay inside /tr/. The EN link points to the same page in English.
const root = tr ? `${base}tr/` : base;
const pathWithoutBase = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname.slice(1);
const languageHref = alternatePath ?? (tr
  ? `${base}${pathWithoutBase.replace(/^tr\//, "")}`
  : `${base}tr/${pathWithoutBase}`);
const links = [
  { id: "product", path: "features", label: tr ? "Ürün" : "Product", group: "product" },
  { id: "modules", path: "modules", label: tr ? "Modüller" : "Modules", group: "product" },
  { id: "breweries", path: "breweries", label: tr ? "Bira üreticileri" : "Breweries", group: "audience" },
  { id: "homebrewers", path: "homebrewers", label: tr ? "Ev biracıları" : "Homebrewers", group: "audience" },
  { id: "pricing", path: "pricing", label: tr ? "Fiyatlandırma" : "Pricing", group: "plans" },
  { id: "how-it-works", path: "how-it-works", label: tr ? "Nasıl çalışır" : "How it works", group: "product" },
  { id: "principles", path: "technical-principles", label: tr ? "İlkeler" : "Principles", mobile: tr ? "Teknik ilkeler" : "Technical principles", group: "plans" },
  { id: "faq", path: "faq", label: tr ? "SSS" : "FAQ", group: "plans" },
];
const mobileGroups = [
  { id: "product", label: tr ? "Ürünü keşfet" : "Explore the product" },
  { id: "audience", label: tr ? "Kimler için?" : "Who it’s for" },
  { id: "plans", label: tr ? "Planlar ve kaynaklar" : "Plans and resources" },
];
---
<header class="site-header" id={home ? "top" : undefined}>
  <a class="wordmark" href={home ? "#top" : root} aria-label={tr ? "GRISTORA ana sayfa" : "GRISTORA home"}><img class="brand-symbol" src={`${base}brand/gristora-symbol.svg`} alt="" aria-hidden="true" width="130" height="160" /><span class="wordmark-text">GRISTORA</span></a>
  <nav class="desktop-nav" aria-label={tr ? "Ana gezinme" : "Main navigation"}>
    {links.map((link) => <a href={`${root}${link.path}/`} aria-current={current === link.id ? "page" : undefined}>{link.label}</a>)}
  </nav>
  <a class="lang-switch" href={languageHref} hreflang={tr ? "en" : "tr"} lang={tr ? "en" : "tr"}>{tr ? "EN" : "TR"}</a>
  <a class="header-cta" href={`${root}breweries/`}>{tr ? "Bira üreticileri için" : "Explore breweries"} <span aria-hidden="true">↗</span></a>
  <details class="mobile-menu">
    <summary aria-label={tr ? "Gezinme menüsü" : "Navigation menu"}><span></span><span></span></summary>
    <nav aria-label={tr ? "Mobil gezinme" : "Mobile navigation"}>
      {mobileGroups.map((group) => (
        <div role="group" aria-labelledby={`nav-${group.id}`}>
          <p class="mobile-group-label" id={`nav-${group.id}`}>{group.label}</p>
          {links.filter((link) => link.group === group.id).map((link) => (
            <a href={`${root}${link.path}/`} aria-current={current === link.id ? "page" : undefined}>{link.mobile ?? link.label}</a>
          ))}
        </div>
      ))}
    </nav>
  </details>
</header>
<style>
  .mobile-menu nav {
    gap: 1rem;
    max-block-size: min(32rem, calc(100dvh - 7rem));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-group-label {
    margin: 0;
    color: var(--muted);
    font-size: .875rem;
    font-weight: 600;
  }
  :global(.sx-home-hero) .mobile-group-label { color: var(--amber-fill); }
  .mobile-menu nav a[aria-current="page"] { text-decoration: underline; text-underline-offset: .25em; }
</style>
