---
import "../styles/global.css";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildBreadcrumbList } from "../data/breadcrumbs";
import "../styles/audience-pages.css";
import "../styles/learning-pages.css";

const base = import.meta.env.BASE_URL;
const allowIndexing = new URL(import.meta.env.SITE).hostname === "gristora.com";
const canonicalUrl = new URL(`${base}how-it-works/`, import.meta.env.SITE).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "How GRISTORA is designed to work",
  description: "Professional brewery workflows are the primary commercial path, with a separate homebrewing journey.",
  url: canonicalUrl,
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", name: "GRISTORA", url: new URL(base, import.meta.env.SITE).href },
};
const homeSteps = [
  { title: "Recipe design", body: "Define the beer, style, ingredients, equipment and batch size.", href: "features/recipe-design/", label: "Recipe design" },
  { title: "Ingredients and water", body: "Bring fermentables, hops, yeast, water and mash assumptions into one recipe context.", href: "features/water-mash-yeast/", label: "Water, mash & yeast" },
  { title: "Calculations", body: "Understand estimates through explicit methods, inputs, units and assumptions. Methods remain subject to validation.", href: "features/brewing-calculations/", label: "Brewing calculations" },
  { title: "Brew day", body: "Keep planned targets distinct from actual quantities, times, temperatures and measurements.", href: "features/brew-day/", label: "Brew-day records" },
  { title: "Fermentation", body: "Bring batch observations and manual or connected readings into the batch history. Predictive models are not approved.", href: "features/fermentation-monitoring/", label: "Fermentation" },
  { title: "Batch review", body: "Review actual results and tasting notes to inform the next recipe iteration.", href: "features/analytics-reports/", label: "Batch insights" },
];
const businessSteps = [
  { title: "Recipe review", body: "Establish the recipe definition, target values and version context for the batch.", href: "features/recipe-design/", label: "Recipe management" },
  { title: "Production planning", body: "Plan production tasks and equipment use within the intended Business workflow.", href: "features/planning-scheduling/", label: "Planning & scheduling" },
  { title: "Batch records", body: "Connect the recipe reference with planned and actual measurements, quantities and operator notes.", href: "features/brew-day/", label: "Production records" },
  { title: "Vessel observations", body: "Keep fermentation and vessel observations in context with the batch. Automated predictions remain gated.", href: "features/fermentation-monitoring/", label: "Fermentation & tracking" },
  { title: "Quality and traceability", body: "Relate quality results and material lots to the production record, subject to product and regulatory validation.", href: "features/quality-laboratory/", label: "Quality & laboratory" },
];
const breadcrumbItems = [{ name: "Home", url: new URL(base, import.meta.env.SITE).href }, { name: "How it works", url: canonicalUrl }];
const breadcrumbData = buildBreadcrumbList(breadcrumbItems);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content="See how GRISTORA is designed for professional brewery workflows, with a separate homebrewing journey." />
    <title>Professional Brewery Workflows & Homebrewing | GRISTORA</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GRISTORA" />
    <meta property="og:title" content="Professional Brewery Workflows & Homebrewing | GRISTORA" />
    <meta property="og:description" content="Professional brewery workflows first, with a separate homebrewing path. Both remain in development." />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Professional Brewery Workflows & Homebrewing | GRISTORA" />
    <meta name="twitter:description" content="Professional brewery workflows first, with a separate homebrewing path. Both remain in development." />
    <meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="GRISTORA home"><img class="brand-symbol" src={`${base}brand/gristora-symbol.svg`} alt="" aria-hidden="true" /><span class="wordmark-text">GRISTORA</span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href={`${base}features/`} aria-current={Astro.url.pathname.startsWith(`${base}features/`) ? "page" : undefined}>Product</a><a href={`${base}breweries/`} aria-current={Astro.url.pathname === `${base}breweries/` ? "page" : undefined}>Breweries</a><a href={`${base}homebrewers/`} aria-current={Astro.url.pathname === `${base}homebrewers/` ? "page" : undefined}>Homebrewers</a><a href={`${base}pricing/`}>Pricing</a><a href={`${base}how-it-works/`} aria-current={Astro.url.pathname === `${base}how-it-works/` ? "page" : undefined}>How it works</a><a href={`${base}technical-principles/`} aria-current={Astro.url.pathname === `${base}technical-principles/` ? "page" : undefined}>Principles</a><a href={`${base}faq/`} aria-current={Astro.url.pathname === `${base}faq/` ? "page" : undefined}>FAQ</a>
      </nav>
      <a class="header-cta" href={`${base}pricing/`}>Plans & pricing <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu"><summary aria-label="Open navigation menu"><span></span><span></span></summary><nav aria-label="Mobile navigation"><a href={`${base}features/`} aria-current={Astro.url.pathname.startsWith(`${base}features/`) ? "page" : undefined}>Product</a><a href={`${base}breweries/`} aria-current={Astro.url.pathname === `${base}breweries/` ? "page" : undefined}>Breweries</a><a href={`${base}homebrewers/`} aria-current={Astro.url.pathname === `${base}homebrewers/` ? "page" : undefined}>Homebrewers</a><a href={`${base}pricing/`}>Pricing</a><a href={`${base}how-it-works/`} aria-current={Astro.url.pathname === `${base}how-it-works/` ? "page" : undefined}>How it works</a><a href={`${base}technical-principles/`} aria-current={Astro.url.pathname === `${base}technical-principles/` ? "page" : undefined}>Technical principles</a><a href={`${base}faq/`} aria-current={Astro.url.pathname === `${base}faq/` ? "page" : undefined}>FAQ</a></nav></details>
    </header>
    <main id="main-content">
      <Breadcrumbs items={breadcrumbItems} />
      <section class="shell explain-page-hero">
        <p class="eyebrow"><span class="eyebrow-line"></span> TWO AUDIENCES · TWO WORKFLOWS · IN DEVELOPMENT</p>
        <h1>Different brewing days. <em>Clearer information.</em></h1>
        <p>GRISTORA is being designed first around the decisions, measurements and records of professional brewery teams. Homebrewers have a separate workflow. Both journeys describe planned product scope, not a live service.</p>
      </section>
      <section class="explain-audience-section explain-business-section section-pad" id="business-workflow">
        <div class="shell">
          <div class="explain-section-head"><div><p class="eyebrow"><span class="eyebrow-line"></span> 01 · PROFESSIONAL BREWERIES</p><h2>From recipe review to <em>production records.</em></h2></div><p>For teams that need shared context around recipes, batches, vessels and quality records.</p></div>
          <figure class="visual-diagram"><img src={`${base}images/diagrams/brewery-record-chain.svg`} alt="Conceptual brewery record model linking recipe version, batch record, ingredient lots, vessel events and quality records." loading="lazy" /><figcaption>Conceptual record relationships · planned product model, not a live feature claim</figcaption></figure>
          <ol class="explain-flow">
            {businessSteps.map((step, index) => <li class="explain-flow-item"><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{step.title}</h3><p>{step.body}</p><a href={`${base}${step.href}`}>{step.label} <span aria-hidden="true">↗</span></a></div></li>)}
          </ol>
          <div class="scope-inline"><strong>Scope boundary</strong><p>GRISTORA is not a general ERP. Sales, customer orders, distribution/shipping, keg tracking, CRM and accounting are outside the product scope.</p></div>
          <a class="text-link explain-audience-link" href={`${base}breweries/`}>Explore the Professional Breweries page <span aria-hidden="true">→</span></a>
        </div>
      </section>
      <section class="explain-audience-section section-pad" id="home-workflow">
        <div class="shell">
          <div class="explain-section-head"><div><p class="eyebrow"><span class="eyebrow-line"></span> 02 · HOMEBREWERS</p><h2>From recipe idea to <em>batch learning.</em></h2></div><p>For the brewer who designs, makes, measures and reviews their own batches.</p></div>
          <figure class="visual-diagram"><img src={`${base}images/diagrams/homebrew-learning-loop.svg`} alt="Five-stage homebrewing learning loop: recipe, ingredients, brew day, fermentation and batch review." loading="lazy" /><figcaption>Illustrative workflow · designed around a repeatable learning loop</figcaption></figure>
          <ol class="explain-flow">
            {homeSteps.map((step, index) => <li class="explain-flow-item"><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{step.title}</h3><p>{step.body}</p><a href={`${base}${step.href}`}>{step.label} <span aria-hidden="true">↗</span></a></div></li>)}
          </ol>
          <a class="text-link explain-audience-link" href={`${base}homebrewers/`}>Explore the Homebrewers page <span aria-hidden="true">→</span></a>
        </div>
      </section>
      <section class="audience-comparison-section section-pad" id="audience-comparison">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> BUSINESS AND HOME · SIDE BY SIDE</p>
            <h2>One product direction. <em>Two distinct workflows.</em></h2>
            <p>This roadmap comparison explains the different information needs and records. It is not a statement that the planned capabilities are already available.</p>
          </div>
          <p class="comparison-scroll-hint">On narrow screens, swipe or scroll horizontally to compare both columns.</p>
          <div class="role-table-wrap" role="region" aria-label="Scrollable comparison of Professional Breweries and Homebrewers workflows" tabindex="0">
            <table class="role-table audience-comparison-table">
              <thead>
                <tr><th scope="col">Dimension</th><th scope="col">Professional Breweries</th><th scope="col">Homebrewers</th></tr>
              </thead>
              <tbody>
                <tr><th scope="row">Primary user</th><td>Brewing teams that need shared production context across recipes, batches, vessels and quality records.</td><td>An individual brewer making, measuring and reviewing personal batches.</td></tr>
                <tr><th scope="row">Core unit of work</th><td>A recipe version and the production batch that references it.</td><td>A recipe and the personal batch made from it.</td></tr>
                <tr><th scope="row">Typical records</th><td>Recipe version, batch plan and actuals, ingredient lots, vessel events, quality and laboratory records.</td><td>Recipe and targets, ingredients and water, brew-day actuals, fermentation observations, tasting and review.</td></tr>
                <tr><th scope="row">Measurement context</th><td>Production measurements, vessel observations and laboratory results, with method, unit, source and operator context.</td><td>Manual readings and any validated supported-device inputs, with source, unit and timestamp.</td></tr>
                <tr><th scope="row">Main question</th><td>What happened across this batch, where did actuals differ, and which records explain the outcome?</td><td>What happened in this brew, and what might I change next time?</td></tr>
                <tr><th scope="row">Scope boundary</th><td>Brewing-specific production records—not sales, orders, shipping, CRM, accounting or a general ERP.</td><td>Personal brewing and learning—not professional multi-batch production operations.</td></tr>
              </tbody>
            </table>
          </div>
          <p class="record-model-note">All examples describe intended information needs. Availability depends on product stage, technical validation and release approval.</p>
        </div>
      </section>
      <section class="explain-disclaimer section-pad"><div class="shell"><p class="eyebrow"><span class="eyebrow-line"></span> PRODUCT MATURITY</p><h2>A workflow describes <em>the design intent.</em></h2><p>All capabilities on this page are part of the product plan unless explicitly identified otherwise. They are not a statement of current availability. Development stage, technical validation and product approval determine what can be released.</p><a class="button button-primary" href={`${base}technical-principles/`}>Read the technical principles <span aria-hidden="true">↗</span></a></div></section>
    </main>
    <footer class="site-footer"><div class="shell footer-main"><a class="wordmark footer-wordmark" href={base}><img class="brand-symbol" src={`${base}brand/gristora-symbol.svg`} alt="" aria-hidden="true" /><span class="wordmark-text">GRISTORA</span></a><p>Brewing software in development for professional breweries, with a separate Homebrewers path.</p><a class="back-top" href={base}>Home ↑</a></div><div class="shell footer-bottom"><span>© {new Date().getFullYear()} GRISTORA</span><span>Made for the craft of brewing.</span></div></footer>
  </body>
</html>
