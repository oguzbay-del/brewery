---
import PagePhoto from "../../components/PagePhoto.astro";
import FontPreload from "../../components/FontPreload.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/global.css";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { buildBreadcrumbList } from "../../data/breadcrumbs";
import "../../styles/audience-pages.css";
import "../../styles/stitch-layout.css";
import "../../styles/pricing.css";
import { featuresTr as features } from "../../data/features.tr";

const breweryAreas = features.filter((feature) => feature.audiences.includes("Breweries"));
const base = import.meta.env.BASE_URL;
const allowIndexing = new URL(import.meta.env.SITE).hostname === "gristora.com";
const canonicalUrl = new URL(`${base}tr/breweries/`, import.meta.env.SITE).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Bira Üretim Yazılımı | GRISTORA",
  url: canonicalUrl,
  description: "Profesyonel bira üretim ekipleri için planlanan reçete, parti ve üretim kayıtları yaklaşımı.",
  inLanguage: "tr",
  isPartOf: { "@type": "WebSite", name: "GRISTORA", url: new URL(`${base}tr/`, import.meta.env.SITE).href },
};
const workflow = [
  { number: "01", title: "Reçeteyi gözden geçirin", question: "Partiye hangi reçete tanımı ve hedefler yön veriyor?", body: "Üretim başlamadan önce reçete amacını, hedef değerleri ve sürüm bağlamını görünür tutun.", feature: "Reçete tasarımı ve yönetimi", href: "recipe-design" },
  { number: "02", title: "İşi planlayın", question: "Ne yapılması gerekiyor ve ne zaman?", body: "İşletme modu için planlanan yaklaşım; üretim planlamasını, görev görünümlerini ve tank çizelgelemesini bir araya getirmeyi hedefler.", feature: "Planlama ve çizelgeleme", href: "planning-scheduling" },
  { number: "03", title: "Partiyi kaydedin", question: "Ne planlanmıştı ve gerçekte ne oldu?", body: "Reçete referansını fiili miktarlar, süreler, sıcaklıklar, ölçümler ve üretim notlarıyla bağlayın.", feature: "Demleme günü ve üretim kayıtları", href: "brew-day" },
  { number: "04", title: "Fermantasyonu ve tankları gözden geçirin", question: "Hangi gözlemler bu partiye ve bu tanka ait?", body: "Planlanan İşletme modu yaklaşımı, parti zaman çizelgelerini, tank bağlamını ve kaydedilen gözlemleri ilişkilendirmeyi hedefler.", feature: "Fermantasyon ve parti takibi", href: "fermentation-monitoring" },
  { number: "05", title: "Kalite ile izlenebilirliği bağlayın", question: "Bir sonuç, kendi parti ve malzeme bağlamında anlaşılabilir mi?", body: "Planlanan İşletme modu yaklaşımı; kalite kayıtlarını, malzeme lotu ilişkilerini ve onay iş akışlarını birbirine bağlamayı hedefler.", feature: "Kalite, laboratuvar ve onay", href: "quality-laboratory" },
];
const roles = [
  { role: "Baş biracı", need: "Reçete amacı, hedef değerler ve parti incelemesi", focus: "Reçete kararları ve tutarlılık" },
  { role: "Üretim operatörü", need: "Planlanan ve fiili değerler ile süreç gözlemleri", focus: "Net kayıtlar ve vardiya devri" },
  { role: "Kalite rolü", need: "Ölçümler, test sonuçları ve izlenebilirlik bağlamı", focus: "Kanıt, inceleme ve onay kayıtları" },
];
const faqs = [
  { q: "GRISTORA bir bira üreticisi ERP'sinin yerini alır mı?", a: "Hayır. GRISTORA, bira üretimiyle ilgili reçete, parti ve üretim bilgisine odaklanır. Genel amaçlı bir ERP olarak konumlandırılmamıştır." },
  { q: "Satış, sipariş, dağıtım veya fıçı takibini yönetir mi?", a: "Hayır. Satış, müşteri siparişleri, dağıtım ve sevkiyat, müşterideki fıçının takibi ve depozitosu, CRM ve muhasebe belirtilen ürün kapsamının dışındadır." },
  { q: "GRISTORA API ve webhook sunar mı?", a: "Açık API ve üretim verisi webhook'ları İşletme modu yol haritasında planlanan entegrasyonlardır; şu anda kullanılabilir bir API veya webhook uç noktası sunulmamaktadır. Ev biracılığı cihaz bağlantıları ayrı bir planlama alanıdır ve cihaz uyumluluğu henüz doğrulanmış değildir." },
  { q: "Roller, izinler ve onaylar nasıl ele alınır?", a: "Rol tabanlı iş akışları ve onay kuyrukları İşletme modu için planlanan tasarımın parçalarıdır; henüz kullanıma sunulmuş iş akışları değildir." },
];
const breadcrumbItems = [{ name: "Ana sayfa", url: new URL(`${base}tr/`, import.meta.env.SITE).href }, { name: "Bira üreticileri", url: canonicalUrl }];
const breadcrumbData = buildBreadcrumbList(breadcrumbItems);
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <FontPreload />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content="Profesyonel bira üreticileri için planlanan GRISTORA yaklaşımı: reçete incelemesi, üretim planlaması, parti kayıtları, kalite ve izlenebilirlik." />
    <title>Bira Üretim Yazılımı | GRISTORA</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GRISTORA" />
    <meta property="og:title" content="Bira Üretim Yazılımı | GRISTORA" />
    <meta property="og:description" content="Profesyonel bira üreticileri için planlanan bira üretim iş akışları: reçete incelemesi, üretim planlaması, parti kayıtları, kalite ve izlenebilirlik." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="tr_TR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Bira Üretim Yazılımı | GRISTORA" />
    <meta name="twitter:description" content="Profesyonel bira üreticileri için planlanan bira üretim iş akışları: reçete incelemesi, üretim planlaması, parti kayıtları, kalite ve izlenebilirlik." />
    <meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ana içeriğe geç</a>
    <SiteHeader current="breweries" lang="tr" />
    <main id="main-content">
      <div class="sx-audience-band">
      <Breadcrumbs lang="tr" items={breadcrumbItems} />
      <section class="shell audience-page-intro">
        <p class="eyebrow"><span class="eyebrow-line"></span> PROFESYONEL BİRA ÜRETİCİLERİ İÇİN</p>
        <h1>Reçete incelemesinden <em>üretim kayıtlarına.</em></h1>
        <p>GRISTORA, reçete kararlarına, parti bilgisine ve üretim kayıtlarına daha net bir bakış isteyen profesyonel bira üretim ekipleri için geliştirilmektedir.</p>
        <a class="button button-primary" href="#brewery-workflow">Bira üreticisi iş akışını keşfedin <span aria-hidden="true">↗</span></a>
      </section>
      <section class="shell audience-hero">
        <PagePhoto name="breweries-hero" lang="tr" eager class="audience-hero-photo" />
      </section>
      </div>
      <section class="audience-page-section section-pad" id="brewery-workflow">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> PROFESYONEL BİRA ÜRETİM İŞ AKIŞI</p>
            <h2>Kararları kayıtlarla <em>birbirine bağlayın.</em></h2>
            <p>İşletme modu için planlanan tasarım, bira üretimine özgü işler etrafında şekillenir.</p>
          </div>
          <ol class="workflow-grid business-workflow-grid">
            {workflow.map((step) => (
              <li class="workflow-card">
                <span class="workflow-number">{step.number}</span>
                <h3>{step.title}</h3>
                <p class="workflow-question">{step.question}</p>
                <p>{step.body}</p>
                <a href={`${base}tr/features/${step.href}/`}>{step.feature} <span aria-hidden="true">↗</span></a>
              </li>
            ))}
          </ol>
        </div>
      </section>
      <section class="role-section section-pad">
        <div class="shell">
          <div class="section-heading"><p class="eyebrow"><span class="eyebrow-line"></span> İNSANLAR VE BİLGİ</p><h2>Farklı roller. <em>Ortak üretim bağlamı.</em></h2><p>Bunlar, bira üretim tesisindeki her rolün ihtiyaçlarıdır.</p></div>
          <div class="role-table-wrap" role="region" aria-label="Kaydırılabilir bira üreticisi rol bilgisi tablosu" tabindex="0">
            <table class="role-table">
              <thead><tr><th scope="col">Rol</th><th scope="col">Birincil bilgi ihtiyacı</th><th scope="col">Editoryal vurgu</th></tr></thead>
              <tbody>{roles.map((item) => <tr><th scope="row">{item.role}</th><td>{item.need}</td><td>{item.focus}</td></tr>)}</tbody>
            </table>
          </div>
        </div>
      </section>
      <section class="record-model-section section-pad">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> KAYIT MODELİ</p>
            <h2>Her partinin arkasındaki <em>bağlamı izleyin.</em></h2>
            <p>Planlanan kayıt modeli, bir üretim kararını bitmiş partiyi açıklayan işlere, malzemelere ve gözlemlere bağlamayı hedefler.</p>
          </div>
          <ol class="record-model-flow business-record-flow">
            <li>
              <span class="record-model-index">01 · REÇETE</span>
              <h3>Reçete sürümü</h3>
              <p>Onaylı reçete tanımı, hedef değerler ve bir parti için seçilen sürüm.</p>
            </li>
            <li>
              <span class="record-model-index">02 · PARTİ</span>
              <h3>Üretim kaydı</h3>
              <p>Planlanan işler ile fiili miktarlar, süreler, sıcaklıklar, ölçümler ve sapmalar yan yana.</p>
            </li>
            <li>
              <span class="record-model-index">03 · MALZEMELER</span>
              <h3>Malzeme lotları</h3>
              <p>Mal kabul ve stok kayıtlarını partiye bağlayan malzeme kullanımı ve lot referansları.</p>
            </li>
            <li>
              <span class="record-model-index">04 · TANK</span>
              <h3>Tank olayları</h3>
              <p>Tank ataması, doluluk, transferler, hacimler ve kaydedilen süreç gözlemleri.</p>
            </li>
            <li>
              <span class="record-model-index">05 · İNCELEME</span>
              <h3>Kalite kayıtları</h3>
              <p>Ölçümler, laboratuvar sonuçları, sapmalar ve belgelenmiş bir inceleme ya da onay kararı.</p>
            </li>
          </ol>
          <p class="record-model-note">Planlanan izlenebilirlik kapsamı, üründe kaydedilecek bilgilere ve desteklenecek lot ilişkilerine bağlı olacaktır.</p>
          <figure class="visual-diagram"><img src={`${base}images/diagrams/business-batch-timeline.svg`} width="960" height="500" alt="Reçete sürümünü, parti planını, üretim kaydını, tank olaylarını ve kalite incelemesini birbirine bağlayan profesyonel bira üreticisi parti zaman çizelgesi." loading="lazy" /><figcaption>İşletme modu parti bağlamı</figcaption></figure>
        </div>
      </section>
      <section class="audience-feature-section section-pad">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> İŞLETME MODU ÜRÜN ALANLARI</p>
            <h2>Bira üretim operasyonları, <em>net sınırlarla.</em></h2>
            <p>İşletme modu için planlanan ürün alanlarını keşfedin.</p>
          </div>
          <div class="audience-feature-grid">
            {breweryAreas.map((feature) => (
              <a class="audience-feature-link" href={`${base}tr/features/${feature.slug}/`}>
                <span>{feature.eyebrow}</span><strong>{feature.title}</strong><small>Yetenekleri keşfedin ↗</small>
              </a>
            ))}
          </div>
        </div>
      </section>
      <section class="erp-boundary-section section-pad">
        <div class="shell erp-boundary-inner">
          <div><p class="eyebrow"><span class="eyebrow-line"></span> ÜRÜN KAPSAMI</p><h2>Bir bira çalışma alanı, <em>genel amaçlı ERP değil.</em></h2></div>
          <div><p>GRISTORA, bira üretimiyle ilgili reçete, parti ve üretim bilgisine odaklanır. Genel amaçlı bir ERP olarak konumlandırılmamıştır ve şunları yönettiğini iddia etmez:</p><ul><li>Satış veya müşteri siparişleri</li><li>Dağıtım, sevkiyat veya teslimat operasyonları</li><li>Müşterideki fıçının takibi ve depozitosu</li><li>CRM veya muhasebe</li></ul><p>Bu sistemleri kendi uzman araçlarında tutun; GRISTORA'nın kapsamı bira üretimine odaklı kalır.</p></div>
        </div>
      </section>
      <section class="audience-faq-section section-pad">
        <div class="shell audience-faq-layout">
          <div class="section-heading"><p class="eyebrow"><span class="eyebrow-line"></span> BİRA ÜRETİCİSİ SSS</p><h2>Ayrıntıdan önce <em>kapsamı bilin.</em></h2></div>
          <div class="audience-faq-list">{faqs.map((faq) => <details class="audience-faq-item"><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</div>
        </div>
      </section>
      <section class="closing-section section-pad"><div class="shell closing-inner"><p class="eyebrow"><span class="eyebrow-line"></span> DETAYLAR ÖNEMLİ</p><h2>Her parti için daha net <em>bir bakış kurun.</em></h2><a class="button button-primary" href={`${base}tr/how-it-works/#business-workflow`}>Bira üreticisi iş akışını keşfedin <span aria-hidden="true">↗</span></a></div></section>

      <section class="pricing-cta section-pad">
        <div class="shell pricing-cta-inner">
          <p class="eyebrow"><span class="eyebrow-line"></span> PLANINIZI SEÇİN</p>
          <h2>Size uygun <em>bira çalışma alanını bulun.</em></h2>
          <p>Ev biracısı ve Profesyonel bira üreticisi yollarını karşılaştırın, ardından bir planı adım adım yapılandırın.</p>
          <a class="button button-primary" href={`${base}tr/pricing/`}>Planlar ve fiyatlandırma <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={`${base}tr/compare/`}>İşlevleri karşılaştırın <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>
    <SiteFooter lang="tr" />
  </body>
</html>
