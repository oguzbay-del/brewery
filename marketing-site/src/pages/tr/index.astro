---
import ProductScreens from "../../components/ProductScreens.astro";
import PagePhoto from "../../components/PagePhoto.astro";
import FontPreload from "../../components/FontPreload.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import "../../styles/global.css";
import "../../styles/home-hero-refinement.css";
import "../../styles/stitch-layout.css";
import { featuresTr as features } from "../../data/features.tr";

const businessSpecificAreas = features.filter((feature) => feature.audiences.length === 1 && feature.audiences.includes("Breweries"));
const sharedBusinessAreas = features.filter((feature) => feature.audiences.length > 1 && feature.audiences.includes("Breweries"));
const featuredAreas = [...businessSpecificAreas, ...sharedBusinessAreas].slice(0, 6);

const homebrewerAreas = features.filter((feature) => feature.audiences.includes("Homebrewers")).slice(0, 4);

const base = import.meta.env.BASE_URL;
const allowIndexing = new URL(import.meta.env.SITE).hostname === "gristora.com";
const canonicalUrl = new URL(`${base}tr/`, import.meta.env.SITE).href;
const pageTitle = "GRISTORA · Bira Üretim Yazılımı";
const description = "GRISTORA, bira üretim ekiplerinin reçete hedeflerini, demleme ölçümlerini ve parti kayıtlarını birlikte takip edebilmesi için geliştiriliyor.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "GRISTORA",
  url: canonicalUrl,
  description,
  inLanguage: "tr",
};

---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <FontPreload />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GRISTORA" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="tr_TR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ana içeriğe geç</a>
    <main id="main-content">
      <section class="sx-hero sx-home-hero">
        <PagePhoto name="home-hero" lang="tr" eager class="sx-home-hero-photo" />
        <div class="sx-home-hero-shade" aria-hidden="true"></div>
        <div class="sx-home-hero-content">
          <SiteHeader home lang="tr" />
          <div class="shell sx-hero-grid sx-home-hero-grid">
            <div class="hero-copy sx-hero-copy">
              <div class="sx-chip-row">
                <p class="sx-chip sx-chip-amber"><span class="sx-dot" aria-hidden="true"></span> BREWING INTELLIGENCE</p>
              </div>
              <h1>Bira üretiminde reçeteden parti kaydına</h1>
              <p class="hero-intro">{description}</p>
              <div class="hero-actions">
                <a class="button button-primary" href={`${base}tr/breweries/`}>Bira üretim ekipleri için <span aria-hidden="true">↗</span></a>
                <a class="hero-secondary" href={`${base}tr/homebrewers/`}>Ev biracıları için <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="sx-band section-pad" id="approach">
        <div class="shell">
          <div class="sx-heading">
            <h2>Bir partinin üretim kaydı</h2>
            <p>Planlanan iş akışını örnek bir parti üzerinden izleyin. Rakamlar bu senaryo için seçilmiştir.</p>
          </div>
          <ol class="sx-card-grid sx-cols-4 batch-example">
            <li class="sx-card">
              <h3>Reçete hedefi</h3>
              <p>Açık renkli ale için hedef parti hacmi 500 litre.</p>
              <a class="text-link" href={`${base}tr/features/recipe-design/`}>Reçete tasarımı</a>
            </li>
            <li class="sx-card">
              <h3>Demleme günü</h3>
              <p>Ekip, fermantasyon tankına aktarılan hacmi 490 litre olarak kaydeder.</p>
              <a class="text-link" href={`${base}tr/features/brew-day/`}>Demleme kayıtları</a>
            </li>
            <li class="sx-card">
              <h3>Fermantasyon</h3>
              <p>İkinci gün aynı tankta ölçülen sıcaklık 19 °C.</p>
              <a class="text-link" href={`${base}tr/features/fermentation-monitoring/`}>Fermantasyon takibi</a>
            </li>
            <li class="sx-card">
              <h3>Parti özeti</h3>
              <p>Üretici, 500 litrelik hedefi 490 litrelik aktarım kaydıyla karşılaştırır.</p>
              <a class="text-link" href={`${base}tr/features/production-management/`}>Üretim yönetimi</a>
            </li>
          </ol>
        </div>
      </section>

      <ProductScreens page="home" lang="tr" />
      <section class="sx-quote-wrap">
        <div class="shell">
          <div class="sx-quote">
            <p class="sx-kicker sx-kicker-light">TEKNİK YAKLAŞIM</p>
            <h2>Sayılar yalnızca gösterilmemeli, <em>anlaşılmalı.</em></h2>
            <p>Bira hesaplamaları net terminolojiyi, tutarlı birimleri ve sonucun arkasında ne olduğuna dair bir açıklamayı hak eder. GRISTORA'nın koyduğu standart budur.</p>
            <a class="sx-light-link" href={`${base}tr/technical-principles/`}>GRISTORA yaklaşımını keşfedin <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="section-pad" id="product-depth">
        <div class="shell">
          <div class="sx-heading sx-heading-split">
            <div>
              <p class="sx-kicker">ÜRÜN, AYRINTILARIYLA</p>
              <h2>Reçetelerden fazlası. <em>Birbirine bağlı bir bira üretim iş akışı.</em></h2>
            </div>
            <p>Önce üretim, kalite ve malzemeleri kapsayan işletme yeteneklerini, ardından ortak reçete ve bira üretim iş akışlarını keşfedin.</p>
          </div>
          <div class="sx-card-grid sx-cols-3">
            {featuredAreas.map((feature, index) => (
              <a class="sx-card sx-card-soft sx-card-link" href={`${base}tr/features/${feature.slug}/`}>
                <span class="sx-num">{String(index + 1).padStart(2, "0")}</span>
                <p class="sx-card-kicker">{feature.eyebrow}</p>
                <h3>{feature.title}</h3>
                <p class="sx-card-foot">KEŞFEDİN <span aria-hidden="true">↗</span></p>
              </a>
            ))}
          </div>
          <p class="sx-more"><a class="text-link" href={`${base}tr/features/`}>Tüm ürün özelliklerini keşfedin <span aria-hidden="true">→</span></a></p>
        </div>
      </section>

      <section class="sx-band section-pad" id="audience-paths">
        <div class="shell">
          <div class="sx-heading sx-heading-center">
            <p class="sx-kicker">BİRA YAPMANIN İKİ YOLU</p>
            <h2><em>Nasıl üretim yapıyorsunuz?</em></h2>
            <p>Ekibinizle üretim yapıyorsanız tesisiniz için planlanan alanları inceleyin. Evde üretiyorsanız kişisel reçete ve parti kayıtlarından başlayın.</p>
          </div>
          <div class="sx-audience-grid">
            <article class="sx-audience" id="breweries">
              <div class="sx-audience-top"><span class="sx-pill sx-pill-dark">BİRİNCİL KİTLE</span><span class="sx-meta">PROFESYONEL BİRA ÜRETİCİLERİ</span></div>
              <h3>Üretim ekibinizle aynı partiyi takip edin.</h3>
              <p>Tesisteki üretim, kalite ve paketleme kayıtlarını bir araya getirmek için planlanan alanları inceleyin.</p>
              <ul class="sx-checks" aria-label="Bira üreticisi alanları">
                {businessSpecificAreas.slice(0, 4).map((feature) => <li>{feature.title}</li>)}
              </ul>
              <div class="sx-audience-foot"><div><span>YOL</span><strong>Profesyonel bira üreticileri</strong></div><a class="text-link" href={`${base}tr/breweries/`}>Üretim iş akışını inceleyin <span aria-hidden="true">↗</span></a></div>
            </article>
            <article class="sx-audience" id="homebrewers">
              <div class="sx-audience-top"><span class="sx-pill">İKİNCİL YOL</span><span class="sx-meta">EV BİRACILARI</span></div>
              <h3>Evde kendi reçetelerinizi geliştirin.</h3>
              <p>Evde üretim için planlanan reçete, hesaplama ve demleme günlüğü özelliklerini inceleyin.</p>
              <ul class="sx-checks" aria-label="Evde bira yapımı alanları">
                {homebrewerAreas.map((feature) => <li>{feature.title}</li>)}
              </ul>
              <div class="sx-audience-foot"><div><span>YOL</span><strong>Ev biracıları</strong></div><a class="text-link" href={`${base}tr/homebrewers/`}>Evde bira yapımını keşfedin <span aria-hidden="true">↗</span></a></div>
            </article>
          </div>
          <p class="audience-compare-link"><a class="text-link" href={`${base}tr/how-it-works/#audience-comparison`}>İki iş akışını karşılaştırın <span aria-hidden="true">→</span></a></p>
        </div>
      </section>

      <section class="sx-cta" id="get-started">
        <div class="shell">
          <div class="sx-cta-inner closing-inner">
            <div>
              <h2>Planları inceleyin</h2>
              <p>Evde üretim ve profesyonel ekipler için planlanan kapsamı karşılaştırın.</p>
            </div>
            <div class="sx-cta-actions">
              <a class="button button-primary" href={`${base}tr/pricing/`}>Plan seçeneklerini görün</a>
              <a class="sx-light-link" href={`${base}tr/compare/`}>Plan kapsamlarını karşılaştırın</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-main">
        <a class="wordmark footer-wordmark" href="#top"><img class="brand-symbol" src={`${base}brand/gristora-symbol.svg`} width="130" height="160" alt="" aria-hidden="true" /><span class="wordmark-text">GRISTORA</span></a>

        <a class="back-top" href="#top">Başa dön ↑</a>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} GRISTORA</span>
        <span>Bira yapma zanaatı için.</span>
      </div>
    </footer>
  </body>
</html>
