---
import FontPreload from "../../components/FontPreload.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/global.css";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { buildBreadcrumbList } from "../../data/breadcrumbs";
import "../../styles/audience-pages.css";
import "../../styles/learning-pages.css";
import "../../styles/stitch-layout.css";

const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(`${base}tr/faq/`, import.meta.env.SITE).href;
const groups = [
  {
    title: "GRISTORA hakkında",
    items: [
      { q: "GRISTORA nedir?", a: "GRISTORA, birincil ticari kitlesi profesyonel bira üreticileri olan ve ayrı bir Ev biracıları yolu bulunan demleme yazılımıdır." },
      { q: "GRISTORA kimler için tasarlandı?", a: "Profesyonel bira üreticisi ekipleri birincil ticari kitledir. Ev biracıları, kendi reçete, demleme günü ve parti incelemesi yolculuğuyla ayrı bir ikincil kitle olarak kalır." },
    ],
  },
  {
    title: "Ürün kapsamı",
    items: [
      { q: "GRISTORA bir bira üreticisi ERP'sinin yerini alır mı?", a: "Hayır. GRISTORA, demlemeyle ilgili reçete, parti ve üretim bilgisine odaklanır. Genel amaçlı bir ERP değildir." },
      { q: "Satış, sipariş, dağıtım veya fıçı takibini yönetir mi?", a: "Hayır. Satış, müşteri siparişleri, dağıtım ve sevkiyat, fıçı takibi, CRM ve muhasebe belirtilen ürün kapsamının dışındadır." },
    ],
  },
  {
    title: "Teknik sorular",
    items: [
      { q: "GRISTORA API, webhook ve cihaz entegrasyonları sunar mı?", a: "İşletme modu açık bir API ve üretim verisi webhook'ları içerir. Ev demlemesi modu Tilt hidrometrelerini, iSpindel ve RAPT cihazlarını, ayrıca uyumlu köprüler için bir webhook veri uç noktasını destekler." },
      { q: "Yöntemler ve birimler hakkında nereden okuyabilirim?", a: "Teknik ilkeler sayfası; yöntemlere, birimlere, ölçümlere ve doğrulamaya yaklaşımı açıklar." },
    ],
  },
  {
    title: "Ticari bilgiler",
    items: [
      { q: "GRISTORA'nın maliyeti nedir? Ücretsiz plan ya da deneme var mı?", a: "Fiyatlandırma sayfası, tek kullanıcılı bir Ev planı ve beşli gruplar halinde 20'ye kadar İşletme koltuğu içeren ayrı Ev biracısı ve Profesyonel bira üreticisi plan yapılarını anlatır. Önerilen deneme koşulları Ev için üç ay, bira üreticisi için bir aydır; ancak bu önizlemede iki deneme de etkin değildir. Önerilen faturalama indirimleri yalnızca karşılaştırma için gösterilir; nihai ticari koşullar ve parasal fiyatlar onaylanmamıştır. Hesap oluşturmadan veya ödeme yapmadan bir plan yapılandırabilirsiniz." },
    ],
  },
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  name: "Sıkça Sorulan Sorular — GRISTORA",
  description: "Profesyonel bira üreticisi ekipleri için GRISTORA'nın demleme yazılımı kapsamı ve ayrı Ev biracıları yoluna dair yanıtlar.",
  url: canonicalUrl,
  inLanguage: "tr",
  isPartOf: { "@type": "WebSite", name: "GRISTORA", url: new URL(`${base}tr/`, import.meta.env.SITE).href },
  mainEntity: groups.flatMap((group) =>
    group.items.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    }))
  ),
};
const breadcrumbItems = [{ name: "Ana sayfa", url: new URL(`${base}tr/`, import.meta.env.SITE).href }, { name: "SSS", url: canonicalUrl }];
const breadcrumbData = buildBreadcrumbList(breadcrumbItems);
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <FontPreload />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content="Profesyonel bira üreticisi ekipleri için GRISTORA'nın demleme yazılımı kapsamına ve ayrı Ev biracıları yoluna dair yanıtlar." />
    <title>Bira Üreticileri için GRISTORA Demleme Yazılımı SSS | Ürün Kapsamı</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GRISTORA" />
    <meta property="og:title" content="Bira Üreticileri için GRISTORA Demleme Yazılımı SSS | Ürün Kapsamı" />
    <meta property="og:description" content="Profesyonel bira üreticisi ekipleri için ürün, demleme kapsamı ve teknik yaklaşım hakkında net yanıtlar." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="tr_TR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Bira Üreticileri için GRISTORA Demleme Yazılımı SSS | Ürün Kapsamı" />
    <meta name="twitter:description" content="Profesyonel bira üreticisi ekipleri için ürün, demleme kapsamı ve teknik yaklaşım hakkında net yanıtlar." />
    <meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ana içeriğe geç</a>
    <SiteHeader current="faq" lang="tr" />
    <main id="main-content" class="faq-page">
      <Breadcrumbs items={breadcrumbItems} />
      <section class="shell explain-page-hero">
        <p class="eyebrow"><span class="eyebrow-line"></span> ÜRÜN · KAPSAM · TEKNİK YAKLAŞIM</p>
        <h1>İyi sorular <em>net yanıtları hak eder.</em></h1>
        <p>Profesyonel bira üreticisi ekipleri GRISTORA'nın birincil kitlesidir. Ev biracılarının ayrı bir ikincil yolu vardır.</p>
      </section>
      <section class="faq-directory section-pad">
        <div class="shell faq-directory-layout">
          <aside class="faq-directory-aside"><p class="eyebrow"><span class="eyebrow-line"></span> KISA BAĞLAM</p><h2>Yöntemler ve birimler, <em>sade biçimde açıklandı.</em></h2><p>Teknik ilkeler, GRISTORA'nın yöntemlere, birimlere ve ölçümlere nasıl yaklaştığını açıklar.</p><a class="text-link" href={`${base}tr/technical-principles/`}>Teknik ilkeleri okuyun <span aria-hidden="true">→</span></a></aside>
          <div class="faq-groups">
            {groups.map((group, index) => (
              <section class="faq-group">
                <p class="eyebrow">{String(index + 1).padStart(2, "0")} · {group.title.toLocaleUpperCase("tr-TR")}</p>
                <div class="audience-faq-list">{group.items.map((item) => <details class="audience-faq-item"><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
              </section>
            ))}
          </div>
        </div>
      </section>
    </main>
    <SiteFooter lang="tr" />
  </body>
</html>
