---
import FontPreload from "../../components/FontPreload.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/global.css";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { buildBreadcrumbList } from "../../data/breadcrumbs";
import "../../styles/learning-pages.css";
import "../../styles/stitch-layout.css";

const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(`${base}tr/technical-principles/`, import.meta.env.SITE).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Demleme Hesaplamaları ve Ölçüm İlkeleri | GRISTORA",
  description: "GRISTORA'nın demleme hesaplamalarına, ölçümlerine ve üretim kayıtlarına yön veren teknik ilkeler.",
  url: canonicalUrl,
  inLanguage: "tr",
  isPartOf: { "@type": "WebSite", name: "GRISTORA", url: new URL(`${base}tr/`, import.meta.env.SITE).href },
};
const principles = [
  { number: "01", title: "Yöntemi açıklayın", body: "Teknik bir sonuca yöntemi, girdileri, birimleri, varsayımları, örneği ve sınırlamaları eşlik etmelidir. Bağlamı olmayan bir sayıyı incelemek ya da yeniden üretmek zordur." },
  { number: "02", title: "Birimleri açık yazın", body: "GRISTORA tutarlı iç değerler ve bölgesel gösterim kullanır. Her açıklama, ilgili olduğunda ABD, İngiliz (Imperial) ve metrik birimleri ayırır ve dönüşümleri net biçimde gösterir." },
  { number: "03", title: "Hedefi fiili değerden ayırın", body: "Reçete hedefi bir ölçüm değildir. Planlanan değerler ile gözlenen sonuçlar birbirinden ayırt edilebilir kalmalıdır; böylece parti kaydı, reçeteyi sessizce yeniden yazmak yerine olanı yansıtır." },
  { number: "04", title: "Ölçüm bağlamını koruyun", body: "Elle girilen, kağıda yazılan ve bağlı cihazdan gelen okumaların kaynakları ve sınırlamaları farklıdır. Kayıt modeli, bu girdilerin desteklendiği her yerde kaynağı ve bağlamı görünür tutar." },
  { number: "05", title: "Tahminden önce doğrulayın", body: "Hesaplama yöntemleri referans vakalar ve gerçek demleme verisi gerektirir." },
  { number: "06", title: "Kontrol insanda kalsın", body: "Tahminler demleyicinin incelemesine bilgi sağlar; reçeteleri, ekipman profillerini veya süreç ayarlarını sessizce değiştirmez. Bir süreç değişikliği kullanıcının açık kararını gerektirir." },
];
const breadcrumbItems = [{ name: "Ana sayfa", url: new URL(`${base}tr/`, import.meta.env.SITE).href }, { name: "Teknik ilkeler", url: canonicalUrl }];
const breadcrumbData = buildBreadcrumbList(breadcrumbItems);
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <FontPreload />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content="GRISTORA'nın demleme hesaplamalarına, birimlerine, ölçümlerine ve üretim kayıtlarına yön veren teknik ilkeleri keşfedin." />
    <title>Demleme Hesaplamaları ve Ölçüm İlkeleri | GRISTORA</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GRISTORA" />
    <meta property="og:title" content="Demleme Hesaplamaları ve Ölçüm İlkeleri | GRISTORA" />
    <meta property="og:description" content="Yöntemler, birimler, ölçümler ve doğrulama; sınırlarıyla birlikte açıklanır." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="tr_TR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Demleme Hesaplamaları ve Ölçüm İlkeleri | GRISTORA" />
    <meta name="twitter:description" content="Yöntemler, birimler, ölçümler ve doğrulama; sınırlarıyla birlikte açıklanır." />
    <meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ana içeriğe geç</a>
    <SiteHeader current="principles" lang="tr" />
    <main id="main-content" class="principles-page">
      <Breadcrumbs items={breadcrumbItems} />
      <section class="shell explain-page-hero">
        <p class="eyebrow"><span class="eyebrow-line"></span> YÖNTEMLER · ÖLÇÜMLER · DOĞRULAMA</p>
        <h1>Teknik netlik, <em>zanaatın bir parçasıdır.</em></h1>
        <p>GRISTORA, anlaşılabilen, kontrol edilebilen ve tartışılabilen demleme bilgisi etrafında tasarlanmıştır. Bu ilkeler, koyduğu standardı tanımlar.</p>
      </section>
      <section class="principles-section section-pad">
        <div class="shell">
          <div class="section-heading"><p class="eyebrow"><span class="eyebrow-line"></span> TASARIM İLKELERİ</p><h2>Güven, <em>işi göstermekten gelir.</em></h2><p>İyi teknik yazılım varsayımları görünür kılar ve insan muhakemesine yer bırakır.</p></div>
          <ol class="principle-grid">
            {principles.map((item) => <li class="principle-card"><span>{item.number}</span><h2>{item.title}</h2><p>{item.body}</p></li>)}
          </ol>
        </div>
      </section>
      <section class="validation-section section-pad">
        <div class="shell validation-layout">
          <div><p class="eyebrow"><span class="eyebrow-line"></span> TEKNİK BİR İDDİA YAYIMLANMADAN ÖNCE</p><h2>Özgüvenden önce <em>kanıt.</em></h2></div>
          <div><p>Herkese açık her hesaplama ya da teknik rehber, tekrarlanabilir bir kanıt kontrol listesine göre gözden geçirilmelidir:</p><ul><li>Adı belli bir yöntem ve yetkili bir referans.</li><li>Girdiler, birimler, varsayılanlar ve varsayımlar.</li><li>Beklenen sonucu ve toleransı olan çalışılmış örnek.</li><li>Bilinen sınırlamalar ve yöntemin kullanılmaması gereken koşullar.</li><li>İnceleyen kişi, doğrulama tarihi ve yöntemin ya da motorun sürümü.</li></ul></div>
        </div>
      </section>
      <section class="technical-visual shell">
        <div class="visual-grid">
          <figure class="visual-diagram"><img src={`${base}images/diagrams/fermentation-profile-example.svg`} width="960" height="520" alt="On iki gün boyunca özgül yoğunluk fermantasyon eğrisi, örnek değerlerle." loading="lazy" /><figcaption>Açıklama için örnek veri</figcaption></figure>
          <figure class="visual-diagram"><img src={`${base}images/diagrams/target-vs-actual-example.svg`} width="960" height="520" alt="Bir hedef çizgisini fiili demleme ölçüm noktalarından ayıran grafik." loading="lazy" /><figcaption>Hedef ve fiili değerler ayrı gösterilir · örnek veri</figcaption></figure>
        </div>
        <figure class="visual-diagram measurement-visual"><img src={`${base}images/diagrams/measurement-source-context.svg`} width="960" height="520" alt="Elle yazılan notların, enstrüman okumalarının ve cihaz okumalarının, ortak zaman damgası, birim, yöntem, kaynak ve kalibrasyon bağlamıyla karşılaştırması." loading="lazy" /><figcaption>Ölçüm kaynağı ilkesi · bir kaydın koruduğu bağlam</figcaption></figure>
        <figure class="visual-diagram visual-diagram-scroll" role="region" aria-label="Kaydırılabilir ekipman kalibrasyon kaydı diyagramı" tabindex="0"><img src={`${base}images/diagrams/calibration-record-model.svg`} width="1100" height="520" alt="Bir enstrümanı, referans standardı, test okumasını, tolerans incelemesini ve kaydedilen durumu birbirine bağlayan, otomatik öneri içermeyen ekipman kalibrasyon kaydı." loading="lazy" /><figcaption>Kaydı incelemek için kaydırın</figcaption></figure>
      </section>
      <section class="explain-disclaimer section-pad"><div class="shell"><p class="eyebrow"><span class="eyebrow-line"></span> KEŞFETMEYE DEVAM EDİN</p><h2>İlkelerin <em>gerçek demleme işine</em> nasıl karşılık geldiğini görün.</h2><p>Ev biracılarının ve profesyonel bira üreticilerinin iş akışları farklıdır. Her yolu ve ürün alanlarını keşfedin.</p><div class="principles-actions"><a class="button button-primary" href={`${base}tr/how-it-works/`}>Nasıl çalışır <span aria-hidden="true">↗</span></a><a class="text-link" href={`${base}tr/features/`}>Ürün alanlarını keşfedin <span aria-hidden="true">→</span></a></div></div></section>
    </main>
    <SiteFooter lang="tr" />
  </body>
</html>
