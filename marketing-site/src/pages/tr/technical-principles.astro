---
import ProductScreens from "../../components/ProductScreens.astro";
import PagePhoto from "../../components/PagePhoto.astro";
import FontPreload from "../../components/FontPreload.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/global.css";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { buildBreadcrumbList } from "../../data/breadcrumbs";
import "../../styles/learning-pages.css";
import "../../styles/stitch-layout.css";

const base = import.meta.env.BASE_URL;
const allowIndexing = new URL(import.meta.env.SITE).hostname === "gristora.com";
const canonicalUrl = new URL(`${base}tr/technical-principles/`, import.meta.env.SITE).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Bira Hesaplamaları ve Ölçüm İlkeleri | GRISTORA",
  description: "GRISTORA'nın planlanan bira hesaplamaları, ölçümleri ve üretim kayıtlarına yön vermesi amaçlanan tasarım ilkeleri.",
  url: canonicalUrl,
  inLanguage: "tr",
  isPartOf: { "@type": "WebSite", name: "GRISTORA", url: new URL(`${base}tr/`, import.meta.env.SITE).href },
};
const principles = [
  { number: "01", title: "Yöntemi açıklayın", body: "Teknik bir sonuca yöntemi, girdileri, birimleri, varsayımları, örneği ve sınırlamaları eşlik etmelidir. Bağlamı olmayan bir sayıyı incelemek ya da yeniden üretmek zordur." },
  { number: "02", title: "Birimleri açık yazın", body: "Amaçlanan yaklaşım, tutarlı iç değerler ve bölgesel gösterim kullanmaktır. Teknik rehberlerde, ilgili olduğunda ABD, İngiliz (Imperial) ve metrik birimlerin ayrılması ve dönüşümlerin açıkça anlatılması hedeflenir." },
  { number: "03", title: "Hedefi fiili değerden ayırın", body: "Reçete hedefi bir ölçüm değildir. Planlanan değerler ile gözlenen sonuçlar birbirinden ayırt edilebilir kalmalıdır; böylece parti kaydı, reçeteyi sessizce yeniden yazmak yerine olanı yansıtır." },
  { number: "04", title: "Ölçüm bağlamını koruyun", body: "Elle girilen, kağıda yazılan ve bağlı cihazdan gelen okumaların kaynakları ve sınırlamaları farklıdır. Planlanan kayıt modelinin, bu girdiler desteklendiğinde kaynağı ve bağlamı görünür tutması amaçlanır." },
  { number: "05", title: "Tahminden önce doğrulayın", body: "Hesaplama yöntemleri referans vakalar ve gerçek üretim verisi gerektirir." },
  { number: "06", title: "Kontrol insanda kalsın", body: "Tasarım ilkesi, tahminlerin biracının incelemesini desteklemesi; reçeteleri, ekipman profillerini veya süreç ayarlarını sessizce değiştirmemesi gerektiğidir. Süreç değişikliği, kullanıcının açık kararını gerektirmelidir." },
];
const breadcrumbItems = [{ name: "Ana sayfa", url: new URL(`${base}tr/`, import.meta.env.SITE).href }, { name: "Teknik ilkeler", url: canonicalUrl }];
const breadcrumbData = buildBreadcrumbList(breadcrumbItems);
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <FontPreload />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content="GRISTORA'nın planlanan bira hesaplamaları, birimleri, ölçümleri ve üretim kayıtlarına yön vermesi amaçlanan tasarım ilkelerini keşfedin." />
    <title>Bira Hesaplamaları ve Ölçüm İlkeleri | GRISTORA</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GRISTORA" />
    <meta property="og:title" content="Bira Hesaplamaları ve Ölçüm İlkeleri | GRISTORA" />
    <meta property="og:description" content="Yöntemler, birimler, ölçümler ve doğrulama; amaçlanan kapsam ve sınırlamalarıyla birlikte." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="tr_TR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Bira Hesaplamaları ve Ölçüm İlkeleri | GRISTORA" />
    <meta name="twitter:description" content="Yöntemler, birimler, ölçümler ve doğrulama; sınırlarıyla birlikte açıklanır." />
    <meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ana içeriğe geç</a>
    <SiteHeader current="principles" lang="tr" />
    <main id="main-content" class="principles-page">
      <Breadcrumbs lang="tr" items={breadcrumbItems} />
      <section class="shell explain-page-hero">
        <p class="eyebrow"><span class="eyebrow-line"></span> YÖNTEMLER · ÖLÇÜMLER · DOĞRULAMA</p>
        <h1>Teknik netlik, <em>zanaatın bir parçasıdır.</em></h1>
        <p>GRISTORA, anlaşılabilen, kontrol edilebilen ve tartışılabilen bira bilgisi etrafında tasarlanmıştır. Bu ilkeler, koyduğu standardı tanımlar.</p>
      </section>
      <div class="page-photo-band"><PagePhoto name="technical-principles-hero" lang="tr" eager /></div>
      <section class="principles-section section-pad">
        <div class="shell">
          <div class="section-heading"><p class="eyebrow"><span class="eyebrow-line"></span> TASARIM İLKELERİ</p><h2>Güven, <em>işi göstermekten gelir.</em></h2><p>İyi teknik yazılım varsayımları görünür kılar ve insan muhakemesine yer bırakır.</p></div>
          <ol class="principle-grid">
            {principles.map((item) => <li class="principle-card"><span>{item.number}</span><h2>{item.title}</h2><p>{item.body}</p></li>)}
          </ol>
        </div>
      </section>
      <ProductScreens page="technical-principles" lang="tr" />
      <section class="validation-section section-pad">
        <div class="shell validation-layout">
          <div><p class="eyebrow"><span class="eyebrow-line"></span> TEKNİK BİR İDDİA YAYIMLANMADAN ÖNCE</p><h2>Özgüvenden önce <em>kanıt.</em></h2></div>
          <div><p>Herkese açık her hesaplama ya da teknik rehber, tekrarlanabilir bir kanıt kontrol listesine göre gözden geçirilmelidir:</p><ul><li>Adı belli bir yöntem ve yetkili bir referans.</li><li>Girdiler, birimler, varsayılanlar ve varsayımlar.</li><li>Beklenen sonucu ve toleransı olan çalışılmış örnek.</li><li>Bilinen sınırlamalar ve yöntemin kullanılmaması gereken koşullar.</li><li>İnceleyen kişi, doğrulama tarihi ve yöntemin ya da motorun sürümü.</li></ul></div>
        </div>
      </section>
      <section class="technical-visual shell">
        <div class="visual-grid">
          <figure class="visual-diagram"><img src={`${base}images/diagrams/fermentation-profile-example.svg`} width="960" height="520" alt="On iki gün boyunca özgül yoğunluk fermantasyon eğrisi, örnek değerlerle." loading="lazy" /><figcaption>Açıklama için örnek veri</figcaption></figure>
          <figure class="visual-diagram"><img src={`${base}images/diagrams/target-vs-actual-example.svg`} width="960" height="520" alt="Bir hedef çizgisini fiili üretim ölçüm noktalarından ayıran grafik." loading="lazy" /><figcaption>Hedef ve fiili değerler ayrı gösterilir · örnek veri</figcaption></figure>
        </div>
        <figure class="visual-diagram measurement-visual"><img src={`${base}images/diagrams/measurement-source-context.svg`} width="960" height="520" alt="Ölçüm kaynaklarını; zaman damgası, birim, yöntem, kaynak ve kalibrasyon bağlamıyla karşılaştıran örnek gösterim." loading="lazy" /><figcaption>Ölçüm kaynağı ilkesi · planlanan kayıt modelinin koruması amaçlanan bağlam</figcaption></figure>
        <figure class="visual-diagram">
          <div class="visual-diagram-scroll" role="region" aria-label="Kaydırılabilir ekipman kalibrasyon kaydı diyagramı" tabindex="0"><img src={`${base}images/diagrams/calibration-record-model.svg`} width="1100" height="520" alt="Bir enstrümanı, referans standardı, test okumasını, tolerans incelemesini ve kaydedilen durumu ilişkilendiren örnek planlanan ekipman kalibrasyon kaydı modeli; otomatik öneri içermez." loading="lazy" /></div>
          <figcaption>Örnek kayıt modelini incelemek için kaydırın</figcaption>
        </figure>
      </section>
      <section class="explain-disclaimer section-pad"><div class="shell"><p class="eyebrow"><span class="eyebrow-line"></span> KEŞFETMEYE DEVAM EDİN</p><h2>İlkelerin <em>gerçek bira üretimine</em> nasıl karşılık geldiğini görün.</h2><p>Ev biracılarının ve profesyonel bira üreticilerinin iş akışları farklıdır. Her yolu ve ürün alanlarını keşfedin.</p><div class="principles-actions"><a class="button button-primary" href={`${base}tr/how-it-works/`}>Nasıl çalışır <span aria-hidden="true">↗</span></a><a class="text-link" href={`${base}tr/features/`}>Ürün alanlarını keşfedin <span aria-hidden="true">→</span></a></div></div></section>
    </main>
    <SiteFooter lang="tr" />
  </body>
</html>
