---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(`${base}breweries/`, import.meta.env.SITE).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f2f7" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content="Brewing software in development for professional breweries." />
    <title>For Professional Breweries — Demleme</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Demleme" />
    <meta property="og:title" content="For Professional Breweries — Demleme" />
    <meta property="og:description" content="Brewing software in development for professional breweries." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="For Professional Breweries — Demleme" />
    <meta name="twitter:description" content="Brewing software in development for professional breweries." />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Demleme home">demleme<span>.</span></a>
      <nav class="desktop-nav" aria-label="Main navigation"><a href={`${base}homebrewers`}>Homebrewers</a><a href={`${base}breweries`}>Breweries</a><a href={`${base}#approach`}>Our approach</a></nav>
      <a class="header-cta" href={`${base}#audience-paths`}>All brewing paths <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu"><summary aria-label="Toggle navigation menu"><span></span><span></span></summary><nav aria-label="Mobile navigation"><a href={`${base}homebrewers`}>Homebrewers</a><a href={`${base}breweries`}>Breweries</a><a href={`${base}#approach`}>Our approach</a></nav></details>
    </header>
    <main id="main-content">
      <section class="shell audience-page-intro">
        <p class="eyebrow"><span class="eyebrow-line"></span> FOR PROFESSIONAL BREWERIES · IN DEVELOPMENT</p>
        <h1>Consistency is built <em>batch by batch.</em></h1>
        <p>Demleme is in development. We are shaping a technical brewing software experience for professional teams that value clear recipe information, repeatable methods and informed review.</p>
        <a class="button button-primary" href="#brewery-focus">Explore the brewery focus <span aria-hidden="true">↗</span></a>
      </section>
      <!-- IMAGE SLOT: BREWERIES-HERO | Replace placeholder with licensed documentary-style photo of a professional brewery floor or team. -->
      <section class="shell audience-hero">
        <div class="image-placeholder" data-image-slot="breweries-hero"><strong>IMAGE PLACEHOLDER · BREWERIES-HERO</strong><span>Professional brewing team, stainless vessels or a working production floor</span></div>
      </section>
      <section class="audience-page-section section-pad" id="brewery-focus">
        <div class="shell audience-page-grid">
          <div><p class="eyebrow"><span class="eyebrow-line"></span> BUILT AROUND THE WORK</p><h2>Make production information easier to work with.</h2><p>Professional brewing depends on repeatable methods and shared understanding. Our aim is to support that work with clear technical information.</p></div>
          <div><p class="eyebrow">DESIGN PRIORITIES</p><ul class="audience-page-list"><li>Structured recipe and batch information</li><li>Clear calculations, units and terminology</li><li>Repeatable methods and informed review</li></ul><p class="audience-page-note">These are product design priorities, not a list of currently available features.</p></div>
        </div>
      </section>
      <section class="closing-section section-pad"><div class="shell closing-inner"><p class="eyebrow"><span class="eyebrow-line"></span> THE DETAILS MATTER</p><h2>Build a clearer view of <em>every batch.</em></h2><a class="button button-primary" href={base}>Explore both brewing paths <span aria-hidden="true">↗</span></a></div></section>
    </main>
    <footer class="site-footer"><div class="shell footer-main"><a class="wordmark footer-wordmark" href={base}>demleme<span>.</span></a><p>Brewing software in development for people who care about the details.</p><a class="back-top" href={base}>Home ↑</a></div><div class="shell footer-bottom"><span>© {new Date().getFullYear()} Demleme</span><span>Made for the craft of brewing.</span></div></footer>
  </body>
</html>
