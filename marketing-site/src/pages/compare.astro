---
import ProductScreens from "../components/ProductScreens.astro";
import PagePhoto from "../components/PagePhoto.astro";
import FontPreload from "../components/FontPreload.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import "../styles/pricing.css";
import "../styles/comparison.css";
import "../styles/stitch-layout.css";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildBreadcrumbList } from "../data/breadcrumbs";
import { features, type FeatureAudience } from "../data/features";
import { modules, moduleLabels } from "../data/modules";

const base = import.meta.env.BASE_URL;
const allowIndexing = new URL(import.meta.env.SITE).hostname === "gristora.com";
const canonicalUrl = new URL(`${base}compare/`, import.meta.env.SITE).href;
const description = "Compare the planned GRISTORA Homebrewer and Professional Brewery product scope and release sequence.";
const rows: { group: string; items: [string, string][] }[] = [
  { group: "Recipes & formulation", items: [
    ["Recipe design & management", "recipe-design"],
    ["Brewing calculations", "brewing-calculations"],
    ["Water, mash & yeast", "water-mash-yeast"],
  ]},
  { group: "Brew day & batch history", items: [
    ["Brew day & production records", "brew-day"],
    ["Fermentation & batch tracking", "fermentation-monitoring"],
    ["Equipment & calibration", "equipment-calibration"],
    ["Planning & scheduling", "planning-scheduling"],
  ]},
  { group: "Professional operations", items: [
    ["Inventory & ingredient lots", "inventory-costing"],
    ["Quality, laboratory & release", "quality-laboratory"],
    ["Team roles & notifications", "team-notifications"],
    ["Production analytics", "analytics-reports"],
  ]},
];
const stageFor = (slug: string, audience: FeatureAudience) => {
  const feature = features.find((item) => item.slug === slug);
  if (!feature || !feature.audiences.includes(audience)) return audience === "Homebrewers" ? "Not in Home path" : "Not in Brewery path";
  const availability = feature.modules.map((id) => modules.find((module) => module.id === id)).filter(Boolean).map((module) => audience === "Homebrewers" ? module!.home : module!.brewery);
  if (availability.includes("Included")) return "Included";
  if (availability.includes("Simplified")) return "Simplified";
  if (availability.includes("Second release")) return "Second release";
  return audience === "Homebrewers" ? "Not in Home path" : "Not in Brewery path";
};
const breadcrumbItems = [{ name: "Home", url: new URL(base, import.meta.env.SITE).href }, { name: "Function comparison", url: canonicalUrl }];
const breadcrumbData = buildBreadcrumbList(breadcrumbItems);
const structuredData = { "@context": "https://schema.org", "@type": "WebPage", name: "Homebrewer vs Professional Brewery feature comparison", description, url: canonicalUrl, inLanguage: "en", isPartOf: { "@type": "WebSite", name: "GRISTORA", url: new URL(base, import.meta.env.SITE).href } };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <FontPreload /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} /><link rel="canonical" href={canonicalUrl} /><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content={description} /><title>Home vs Brewery Function Comparison | GRISTORA</title>
    <meta property="og:type" content="website" /><meta property="og:site_name" content="GRISTORA" /><meta property="og:title" content="Home vs Brewery Function Comparison | GRISTORA" /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl} /><meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} /><meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content="Home vs Brewery Function Comparison | GRISTORA" /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} /><script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content" class="compare-page">
      <section class="pricing-hero compare-hero shell">
        <Breadcrumbs items={breadcrumbItems} />
        <p class="eyebrow"><span class="eyebrow-line"></span> TWO PATHS · ONE BREWING MINDSET</p><h1>Choose the workspace that <em>fits your brew.</em></h1><p class="pricing-lede">Compare the planned workflows side by side, from personal recipe records to production planning for a team. Then preview the plan that fits your setup.</p><div class="compare-hero-actions"><a class="button button-primary" href={`${base}pricing/`}>View plans & pricing ↗</a><a class="text-link" href={`${base}get-started/`}>Configure a plan →</a></div></section>
      <div class="page-photo-band"><PagePhoto name="compare-hero" lang="en" eager /></div>
      <section class="compare-table-section section-pad">
        <div class="shell">
        <p class="pricing-footnote">The labels below describe intended product scope and planned release sequence; they do not indicate that a feature is currently available.</p>
        <div class="comparison-table-wrap" role="region" aria-label="Scrollable Homebrewer and Professional Brewery function comparison" tabindex="0">
          <table class="comparison-table" aria-label="Comparison of GRISTORA product areas for Homebrewers and Professional Breweries">
            <thead><tr><th scope="col">Product area</th><th scope="col">Homebrewer · 1 user</th><th scope="col">Professional Brewery · 5+ users</th></tr></thead>
            <tbody>
              {rows.map((group) => <><tr class="comparison-group"><th colspan="3" scope="colgroup">{group.group}</th></tr>{group.items.map(([label, slug]) => { const feature = features.find((item) => item.slug === slug); const homeStage = stageFor(slug, "Homebrewers"); const businessStage = stageFor(slug, "Breweries"); return <tr><th scope="row"><a href={`${base}features/${slug}/`}>{label} ↗</a><small class="comparison-module-label">{feature?.modules.map((id) => moduleLabels[id]).join(" · ")}</small></th><td><span class={homeStage.startsWith("Not in") ? "stage-muted" : "stage-pill"}>{homeStage}</span></td><td><span class={businessStage.startsWith("Not in") ? "stage-muted" : "stage-pill"}>{businessStage}</span></td></tr>; })}</>)}
            </tbody>
          </table>
        </div>
        <p class="pricing-footnote">Open each feature for detailed scope. <a href={`${base}modules/`}>Explore the nine-module plan and scope →</a></p>
        </div>
      </section>
      <ProductScreens page="compare" lang="en" />
      <section class="compare-decision section-pad"><div class="shell"><div class="compare-decision-grid"><article><p class="eyebrow">HOME BREWERS</p><figure class="compare-audience-visual"><img src={`${base}audience/homebrewer.svg`} alt="Illustration of a home brewer’s small-batch setup with a kettle, glass fermenter, ingredients and recipe notebook." width="1200" height="675" loading="lazy" decoding="async" /><figcaption>SMALL-BATCH · PERSONAL WORKSPACE</figcaption></figure><h2>One person, <em>one brewing journey.</em></h2><p>Choose Home if you brew for yourself and want your recipes, calculations, measurements and batch learning in one personal workspace.</p><a class="button button-primary" href={`${base}get-started/?audience=home`}>Configure Home plan →</a></article><article><p class="eyebrow">PROFESSIONAL BREWERIES</p><figure class="compare-audience-visual"><img src={`${base}audience/professional-brewery.svg`} alt="Illustration of a professional brewery with stainless-steel brewing tanks and connected pipework." width="1200" height="675" loading="lazy" decoding="async" /><figcaption>PRODUCTION · SHARED BY A TEAM</figcaption></figure><h2>Production work, <em>shared by a team.</em></h2><p>Choose Brewery if several people need a shared professional workflow around recipe standards, production planning and batch records.</p><a class="button button-primary" href={`${base}get-started/?audience=business`}>Configure Brewery plan →</a></article></div><p class="compare-all-features"><a href={`${base}features/`}>Browse all feature details and the complete catalogue ↗</a></p></div></section>
    </main>
    <SiteFooter />
  </body>
</html>
