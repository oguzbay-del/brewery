---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;

const audiences = [
  {
    id: "breweries",
    number: "02",
    eyebrow: "FOR PROFESSIONAL BREWERIES",
    title: "Build consistency around every batch.",
    description:
      "A technical perspective on recipe and batch information for professional brewing teams.",
    link: "Explore brewery workflows",
    href: `${base}breweries`,
    visual: "brewery",
    visualLabel: "A working craft brewery",
  },
  {
    id: "homebrewers",
    number: "01",
    eyebrow: "FOR HOME BREWERS",
    title: "Make room for better brewing.",
    description:
      "A technical perspective on recipes, brewing calculations and the decisions behind every brew.",
    link: "Explore homebrewing",
    href: `${base}homebrewers`,
    visual: "home",
    visualLabel: "A considered homebrew setup",
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f3ee" />
    <meta
      name="description"
      content="Brewing software in development for professional breweries, with a separate path for homebrewers. Explore recipe decisions and production records."
    />
    <title>Demleme — Brewing software for people who care about the details</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Demleme home">demleme<span>.</span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href={`${base}homebrewers`}>Homebrewers</a>
        <a href={`${base}breweries`}>Breweries</a>
        <a href="#approach">Our approach</a>
      </nav>
      <a class="header-cta" href="#audience-paths">Find your path <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu">
        <summary aria-label="Open navigation menu">
          <span></span><span></span>
        </summary>
        <nav aria-label="Mobile navigation">
          <a href={`${base}homebrewers`}>Homebrewers</a>
          <a href={`${base}breweries`}>Breweries</a>
          <a href="#approach">Our approach</a>
          <a class="mobile-menu-cta" href="#audience-paths">Find your path ↗</a>
        </nav>
      </details>
    </header>

    <main id="top">
      <section class="hero shell">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> BREWING SOFTWARE / FOR PROFESSIONAL BREWERIES</p>
          <h1>Brewing software for professional breweries that <em>care about the details.</em></h1>
          <p class="hero-intro">
            A technical workspace for homebrewers and professional breweries.
            Explore a clearer way to work with the details behind every brew.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={`${base}breweries`}>Explore breweries <span aria-hidden="true">↗</span></a>
            <a class="text-link" href={`${base}homebrewers`}>For homebrewers <span aria-hidden="true">→</span></a>
          </div>
          <div class="hero-note">
            <span class="note-rule"></span>
            <span>Thoughtful tools for the work behind the beer.</span>
          </div>
        </div>

        <!-- IMAGE SLOT: HOME-HERO | Replace .brew-illustration SVG with licensed brewing-process photography. Keep the art-index and art-caption overlays. -->
        <div class="hero-art" data-image-slot="home-hero" aria-label="Temporary editorial illustration; replace with brewing photography">
          <div class="art-index">FIELD NOTES <span>001 / BREWING</span></div>
          <svg class="brew-illustration" viewBox="0 0 620 650" role="img" aria-labelledby="brew-title brew-desc">
            <title id="brew-title">The craft of brewing</title>
            <desc id="brew-desc">A detailed line illustration of a stainless brewing kettle, a glass hydrometer cylinder, barley and hop leaves.</desc>
            <defs>
              <pattern id="grain" width="16" height="16" patternUnits="userSpaceOnUse">
                <circle cx="4" cy="4" r="1.6" fill="#a77a42" opacity=".55"/>
                <circle cx="12" cy="11" r="1.2" fill="#a77a42" opacity=".4"/>
              </pattern>
              <linearGradient id="wort" x1="0" x2="1" y1="0" y2="1">
                <stop offset="0" stop-color="#d9a04f"/>
                <stop offset="1" stop-color="#a85d1d"/>
              </linearGradient>
            </defs>
            <path d="M310 84 C390 116 457 186 481 282 C504 375 469 474 394 526" fill="none" stroke="#c9b99e" stroke-width="1.2"/>
            <path d="M284 100 C194 128 126 199 112 293 C96 393 147 479 224 524" fill="none" stroke="#c9b99e" stroke-width="1.2"/>
            <g transform="translate(145 170)">
              <path d="M76 88 L76 350 Q76 378 105 388 L286 388 Q315 378 315 350 L315 88" fill="#e5e0d5" stroke="#4c514c" stroke-width="3"/>
              <path d="M65 88 Q195 54 326 88 L315 110 Q195 82 76 110Z" fill="#c9c6bd" stroke="#4c514c" stroke-width="3"/>
              <path d="M88 225 Q196 239 303 225 L303 350 Q303 369 282 373 L109 373 Q88 369 88 350Z" fill="url(#wort)" opacity=".82"/>
              <path d="M89 225 Q195 239 302 225" fill="none" stroke="#8d4e1d" stroke-width="2"/>
              <path d="M58 115 L29 115 Q12 115 12 132 L12 160 Q12 177 30 177 L76 177" fill="none" stroke="#4c514c" stroke-width="7"/>
              <path d="M315 115 L359 115 Q378 115 378 133 L378 160 Q378 178 359 178 L315 178" fill="none" stroke="#4c514c" stroke-width="7"/>
              <path d="M128 68 Q195 28 263 68" fill="none" stroke="#4c514c" stroke-width="3"/>
              <path d="M180 34 L180 8 L210 8 L210 34" fill="none" stroke="#4c514c" stroke-width="3"/>
              <circle cx="195" cy="150" r="24" fill="#f5f3ee" stroke="#4c514c" stroke-width="2"/>
              <path d="M195 150 L207 138" stroke="#a85d1d" stroke-width="2.5" stroke-linecap="round"/>
              <circle cx="195" cy="150" r="3" fill="#4c514c"/>
              <path d="M190 174 L190 191" stroke="#4c514c" stroke-width="2"/>
              <path d="M108 388 L96 408 M282 388 L294 408" stroke="#4c514c" stroke-width="4"/>
              <path d="M92 410 L298 410" stroke="#4c514c" stroke-width="3"/>
            </g>
            <g transform="translate(54 405) rotate(-13)">
              <path d="M0 0 Q48 -28 91 4 Q50 38 0 0Z" fill="#8a9462" stroke="#4f6343" stroke-width="2"/>
              <path d="M5 1 L82 3 M28 -5 L39 20 M48 -9 L56 17" stroke="#4f6343" stroke-width="1.5"/>
              <path d="M30 -13 Q48 -58 80 -38 Q93 -11 65 4 Q47 16 30 -13Z" fill="#a2a66f" stroke="#4f6343" stroke-width="2"/>
              <path d="M48 -18 L70 -36 M49 -17 L80 -20 M47 -16 L62 1" stroke="#4f6343" stroke-width="1.2"/>
            </g>
            <g transform="translate(420 120) rotate(12)">
              <path d="M22 0 C-2 32 4 66 25 85 C48 66 52 31 22 0Z" fill="#9da475" stroke="#536448" stroke-width="2"/>
              <path d="M22 8 L25 78 M22 30 L7 44 M24 44 L40 55" stroke="#536448" stroke-width="1.5"/>
              <path d="M50 18 C30 50 39 83 61 97 C83 76 80 42 50 18Z" fill="#b2aa75" stroke="#536448" stroke-width="2"/>
              <path d="M51 26 L61 90 M53 48 L39 59 M56 62 L74 71" stroke="#536448" stroke-width="1.5"/>
            </g>
            <g transform="translate(430 438)">
              <path d="M0 0 L94 0 L85 144 Q47 161 9 144Z" fill="#e9e5da" fill-opacity=".7" stroke="#59605b" stroke-width="2"/>
              <path d="M8 72 Q48 82 87 72 L82 139 Q47 151 13 139Z" fill="#d6a451" fill-opacity=".55"/>
              <path d="M47 20 L47 126 M31 40 L64 40 M31 60 L64 60 M31 80 L64 80 M31 100 L64 100" stroke="#7e8278" stroke-width="1"/>
              <path d="M47 18 L47 111" stroke="#8e5b24" stroke-width="2"/>
              <circle cx="47" cy="110" r="5" fill="#8e5b24"/>
            </g>
            <g fill="#5e655d" font-family="monospace" font-size="10" letter-spacing="2">
              <text x="42" y="604">MALT</text><text x="253" y="604">WORT</text><text x="462" y="604">MEASURE</text>
            </g>
            <path d="M42 584 H578" stroke="#bdb4a4" stroke-width="1"/>
          </svg>
          <div class="art-caption"><span>01 — THE BREWING PROCESS</span><span>INGREDIENTS / METHOD / RECORD</span></div>
        </div>
      </section>

      <section class="audience-section section-pad" id="audience-paths">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> TWO WAYS TO BREW</p>
            <h2>One craft. <em>Different working days.</em></h2>
            <p>Start with professional brewery workflows, or explore the separate homebrewing path.</p>
          </div>
          <div class="audience-grid">
            {audiences.map((audience) => (
              <article class="audience-card" id={audience.id}>
                <!-- IMAGE SLOT: AUDIENCE-HOMEBREWERS / AUDIENCE-BREWERIES | Replace each SVG with its matching licensed photograph. -->
                <div class:list={["audience-image", audience.visual]} data-image-slot={`audience-${audience.id}`}>
                  {audience.visual === "home" ? (
                    <svg viewBox="0 0 600 320" aria-hidden="true">
                      <path d="M0 252 H600" stroke="currentColor" opacity=".3"/>
                      <path d="M110 220 V104 Q110 82 132 82 H300 Q322 82 322 104 V220" fill="none" stroke="currentColor" stroke-width="3"/>
                      <path d="M96 220 H338 M132 82 Q216 54 300 82" fill="none" stroke="currentColor" stroke-width="3"/>
                      <path d="M153 150 Q216 163 279 150 V213 H153Z" fill="#b87b37" opacity=".45"/>
                      <path d="M400 250 Q415 210 447 205 Q470 208 481 250" fill="none" stroke="currentColor" stroke-width="3"/>
                      <path d="M422 205 Q407 177 432 157 Q457 178 447 205 M449 204 Q448 172 477 164 Q490 193 463 211" fill="#89946c" stroke="currentColor" stroke-width="2"/>
                      <path d="M60 254 Q100 237 140 254 M352 254 Q392 236 432 254" fill="none" stroke="currentColor" opacity=".4"/>
                    </svg>
                  ) : (
                    <svg viewBox="0 0 600 320" aria-hidden="true">
                      <path d="M0 252 H600" stroke="currentColor" opacity=".3"/>
                      <g fill="none" stroke="currentColor" stroke-width="3">
                        <path d="M82 250 V88 Q82 64 106 64 H225 Q249 64 249 88 V250"/>
                        <path d="M275 250 V55 Q275 30 300 30 H420 Q445 30 445 55 V250"/>
                        <path d="M469 250 V112 Q469 88 493 88 H550 Q574 88 574 112 V250"/>
                        <path d="M64 250 H590 M106 64 V42 H225 V64 M300 30 V12 H420 V30"/>
                        <path d="M130 112 H201 M324 92 H396 M495 142 H550"/>
                      </g>
                      <g fill="#a9a99b" opacity=".42">
                        <path d="M85 188 H246 V249 H85Z"/><path d="M278 173 H442 V249 H278Z"/><path d="M472 202 H571 V249 H472Z"/>
                      </g>
                      <path d="M248 112 H275 M445 112 H469 M170 250 V275 M362 250 V275 M522 250 V275" stroke="currentColor" stroke-width="3"/>
                    </svg>
                  )}
                  <span class="image-label">{audience.visualLabel}</span>
                  <span class="image-index">{audience.number}</span>
                </div>
                <div class="audience-copy">
                  <p class="eyebrow">{audience.eyebrow}</p>
                  <h3>{audience.title}</h3>
                  <p>{audience.description}</p>
                  <a class="text-link" href={audience.href}>{audience.link} <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="details-section section-pad" id="approach">
        <div class="shell details-layout">
          <div class="details-intro">
            <p class="eyebrow"><span class="eyebrow-line"></span> THE DETAILS MATTER</p>
            <h2>Good brewing starts with <em>good information.</em></h2>
          </div>
          <div class="details-content">
            <p class="details-lead">
              Brewing is a balance of ingredients, process and observation.
              Demleme is being built around the information that helps brewers
              make sense of each decision.
            </p>
            <div class="principles">
              <div class="principle">
                <span class="principle-number">01</span>
                <div><h3>Clear inputs</h3><p>Keep the details behind a recipe in view.</p></div>
              </div>
              <div class="principle">
                <span class="principle-number">02</span>
                <div><h3>Understandable calculations</h3><p>Know what a brewing number represents.</p></div>
              </div>
              <div class="principle">
                <span class="principle-number">03</span>
                <div><h3>Useful records</h3><p>Give each brew a better foundation for the next one.</p></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="technical-section">
        <div class="shell technical-layout">
          <div class="technical-mark" aria-hidden="true">
            <span>DM</span><i></i><span>01</span>
          </div>
          <div class="technical-copy">
            <p class="eyebrow"><span class="eyebrow-line"></span> A TECHNICAL APPROACH</p>
            <h2>Numbers should be <em>understood,</em> not just displayed.</h2>
            <p>
              Brewing calculations deserve clear terminology, consistent units
              and an explanation of what sits behind the result. That is the
              standard Demleme is working towards.
            </p>
            <a class="text-link" href={`${base}breweries`}>Explore the brewery workflow <span aria-hidden="true">→</span></a>
          </div>
          <div class="technical-note">
            <span class="note-kicker">A PRINCIPLE, NOT A CLAIM</span>
            <p>Technical clarity belongs in the product — and in the way we explain it.</p>
            <span class="note-foot">DEMLEME / BREWING SOFTWARE</span>
          </div>
        </div>
      </section>

      <section class="closing-section section-pad" id="get-started">
        <div class="shell closing-inner">
          <p class="eyebrow"><span class="eyebrow-line"></span> FIND YOUR WAY INTO DEMLEME</p>
          <h2>Make every brew <em>more considered.</em></h2>
          <p>Explore the professional brewery path first, or choose the separate homebrewing journey.</p>
          <a class="button button-primary" href={`${base}breweries`}>Explore brewery workflows <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-main">
        <a class="wordmark footer-wordmark" href="#top">demleme<span>.</span></a>
        <p>Technical brewing software for people who care about the details.</p>
        <a class="back-top" href="#top">Back to top ↑</a>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} Demleme</span>
        <span>Made for the craft of brewing.</span>
      </div>
    </footer>
  </body>
</html>
