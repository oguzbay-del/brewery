---
import "../styles/global.css";
import "../styles/home-hero-refinement.css";
import "../styles/stitch-layout.css";
import { features } from "../data/features";

const businessSpecificAreas = features.filter((feature) => feature.audiences.length === 1 && feature.audiences.includes("Breweries"));
const sharedBusinessAreas = features.filter((feature) => feature.audiences.length > 1 && feature.audiences.includes("Breweries"));
const featuredAreas = [...businessSpecificAreas, ...sharedBusinessAreas].slice(0, 6);

const homebrewerAreas = features.filter((feature) => feature.audiences.includes("Homebrewers")).slice(0, 4);

const base = import.meta.env.BASE_URL;
const allowIndexing = new URL(import.meta.env.SITE).hostname === "gristora.com";
const canonicalUrl = new URL(base, import.meta.env.SITE).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "GRISTORA",
  url: canonicalUrl,
  description: "GRISTORA — Brewing Intelligence for the craft and science of brewing.",
  inLanguage: "en",
};

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta
      name="description"
      content="GRISTORA — Brewing Intelligence for the craft and science of brewing."
    />
    <title>GRISTORA</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GRISTORA" />
    <meta property="og:title" content="GRISTORA" />
    <meta property="og:description" content="GRISTORA — Brewing Intelligence." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="GRISTORA" />
    <meta name="twitter:description" content="GRISTORA — Brewing Intelligence." />
    <meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header" id="top">
      <a class="wordmark" href="#top" aria-label="GRISTORA home"><img class="brand-symbol" src={`${base}brand/gristora-symbol.svg`} alt="" aria-hidden="true" /><span class="wordmark-text">GRISTORA</span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href={`${base}features/`}>Product</a>
        <a href={`${base}breweries/`}>Breweries</a>
        <a href={`${base}homebrewers/`}>Homebrewers</a>
        <a href={`${base}pricing/`}>Pricing</a><a href={`${base}how-it-works/`}>How it works</a>
        <a href={`${base}technical-principles/`}>Principles</a><a href={`${base}faq/`}>FAQ</a>
      </nav>
      <a class="header-cta" href={`${base}breweries/`}>Explore breweries <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu">
        <summary aria-label="Open navigation menu">
          <span></span><span></span>
        </summary>
        <nav aria-label="Mobile navigation">
          <a href={`${base}features/`}>Product</a>
          <a href={`${base}breweries/`}>Breweries</a>
          <a href={`${base}homebrewers/`}>Homebrewers</a>
          <a href={`${base}pricing/`}>Pricing</a><a href={`${base}how-it-works/`}>How it works</a>
          <a href={`${base}technical-principles/`}>Technical principles</a><a href={`${base}faq/`}>FAQ</a>
        </nav>
      </details>
    </header>

    <main id="main-content">
      <section class="sx-hero">
        <div class="shell sx-hero-grid">
          <div class="hero-copy sx-hero-copy">
            <div class="sx-chip-row">
              <p class="sx-chip sx-chip-amber"><span class="sx-dot" aria-hidden="true"></span> BREWING INTELLIGENCE</p>
            </div>

            <h1>GRISTORA</h1>
            <p class="hero-intro">
              Explore how recipe standards, production context and batch records come together for brewing teams.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href={`${base}breweries/`}>Explore professional breweries <span aria-hidden="true">↗</span></a>
              <a class="text-link hero-secondary" href={`${base}homebrewers/`}>For homebrewers <span aria-hidden="true">→</span></a>
            </div>
            <ul class="sx-facts" aria-label="Project summary">
              <li><span>PRIMARY AUDIENCE</span><strong>Professional breweries</strong></li>
              <li><span>SECONDARY PATH</span><strong>Homebrewers</strong></li>
            </ul>
          </div>

          <aside class="sx-panel" aria-labelledby="sx-panel-title">
            <div class="sx-panel-head">
              <p class="sx-panel-kicker" id="sx-panel-title">THE WORKFLOW</p>
            </div>

            <ol class="sx-panel-steps">
              <li><span class="sx-step-no">01</span><div><strong>Recipe standard</strong><p>Ingredients, targets and method, kept with their version context.</p></div></li>
              <li><span class="sx-step-no">02</span><div><strong>Production context</strong><p>Scheduled work, vessels and the decisions behind each batch.</p></div></li>
              <li><span class="sx-step-no">03</span><div><strong>Batch record</strong><p>What was planned, and what was actually recorded.</p></div></li>
            </ol>

          </aside>
        </div>
      </section>

      <section class="sx-band section-pad" id="approach">
        <div class="shell">
          <div class="sx-heading">
            <p class="sx-kicker">THE DETAILS MATTER</p>
            <h2>Good brewing starts with <em>good information.</em></h2>
            <p>Brewing is a balance of ingredients, process and observation. GRISTORA is built around the information that helps brewers make sense of each decision.</p>
          </div>
          <div class="sx-card-grid sx-cols-4">
            <article class="sx-card">
              <span class="sx-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h10M4 18h7"/></svg></span>
              <p class="sx-card-kicker">01 / RECIPE DETAILS</p>
              <h3>Recipe standards</h3>
              <p>Keep ingredients, targets and methods together.</p>
              <p class="sx-card-foot">BREWING WORKFLOW</p>
            </article>
            <article class="sx-card">
              <span class="sx-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 18l5-6 4 3 7-9"/></svg></span>
              <p class="sx-card-kicker">02 / CALCULATIONS</p>
              <h3>Understandable calculations</h3>
              <p>Know what a brewing number represents.</p>
              <p class="sx-card-foot">BREWING WORKFLOW</p>
            </article>
            <article class="sx-card">
              <span class="sx-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 20h18M5 20V8l7-4 7 4v12M9 20v-6h6v6"/></svg></span>
              <p class="sx-card-kicker">03 / PRODUCTION CONTEXT</p>
              <h3>Production context</h3>
              <p>Keep vessels, schedules and decisions in view.</p>
              <p class="sx-card-foot">BREWING WORKFLOW</p>
            </article>
            <article class="sx-card">
              <span class="sx-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h9l3 3v15H6zM9 11h6M9 15h6M9 18h4"/></svg></span>
              <p class="sx-card-kicker">04 / BATCH RECORDS</p>
              <h3>Useful records</h3>
              <p>Keep planned and recorded details distinct.</p>
              <p class="sx-card-foot">BREWING WORKFLOW</p>
            </article>
          </div>
        </div>
      </section>

      <section class="sx-quote-wrap">
        <div class="shell">
          <div class="sx-quote">
            <p class="sx-kicker sx-kicker-light">A TECHNICAL APPROACH</p>
            <h2>Numbers should be <em>understood,</em> not just displayed.</h2>
            <p>Brewing calculations deserve clear terminology, consistent units and an explanation of what sits behind the result. That is the standard GRISTORA sets.</p>
            <a class="sx-light-link" href={`${base}technical-principles/`}>Discover the GRISTORA approach <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="section-pad" id="product-depth">
        <div class="shell">
          <div class="sx-heading sx-heading-split">
            <div>
              <p class="sx-kicker">THE PRODUCT, IN DEPTH</p>
              <h2>More than recipes. <em>A connected brewing workflow.</em></h2>
            </div>
            <p>Explore the Business capabilities first, including production, quality and materials, followed by shared recipe and brewing workflows.</p>
          </div>
          <div class="sx-card-grid sx-cols-3">
            {featuredAreas.map((feature, index) => (
              <a class="sx-card sx-card-soft sx-card-link" href={`${base}features/${feature.slug}/`}>
                <span class="sx-num">{String(index + 1).padStart(2, "0")}</span>
                <p class="sx-card-kicker">{feature.eyebrow}</p>
                <h3>{feature.title}</h3>
                <p class="sx-card-foot">EXPLORE <span aria-hidden="true">↗</span></p>
              </a>
            ))}
          </div>
          <p class="sx-more"><a class="text-link" href={`${base}features/`}>Explore all product features <span aria-hidden="true">→</span></a></p>
        </div>
      </section>

      <section class="sx-band section-pad" id="audience-paths">
        <div class="shell">
          <div class="sx-heading sx-heading-center">
            <p class="sx-kicker">TWO WAYS TO BREW</p>
            <h2>Built around professional brewing. <em>Open to every brewer.</em></h2>
            <p>Start with the operational needs of your brewery, or explore the separate Homebrewers path.</p>
          </div>
          <div class="sx-audience-grid">
            <article class="sx-audience" id="breweries">
              <div class="sx-audience-top"><span class="sx-pill sx-pill-dark">PRIMARY AUDIENCE</span><span class="sx-meta">PROFESSIONAL BREWERIES</span></div>
              <h3>Bring consistency to every batch.</h3>
              <p>A technical workspace built around recipe standards, production context and reliable batch records for brewing teams.</p>
              <ul class="sx-checks" aria-label="Brewery areas">
                {businessSpecificAreas.slice(0, 4).map((feature) => <li>{feature.title}</li>)}
              </ul>
              <div class="sx-audience-foot"><div><span>PATH</span><strong>Professional Breweries</strong></div><a class="text-link" href={`${base}breweries/`}>Explore professional breweries <span aria-hidden="true">↗</span></a></div>
            </article>
            <article class="sx-audience" id="homebrewers">
              <div class="sx-audience-top"><span class="sx-pill">SECONDARY PATH</span><span class="sx-meta">HOMEBREWERS</span></div>
              <h3>Make room for better brewing.</h3>
              <p>A separate path for homebrewers exploring recipes, brewing calculations and the decisions behind every brew.</p>
              <ul class="sx-checks" aria-label="Homebrewing areas">
                {homebrewerAreas.map((feature) => <li>{feature.title}</li>)}
              </ul>
              <div class="sx-audience-foot"><div><span>PATH</span><strong>Homebrewers</strong></div><a class="text-link" href={`${base}homebrewers/`}>Explore homebrewing <span aria-hidden="true">↗</span></a></div>
            </article>
          </div>
          <p class="audience-compare-link"><a class="text-link" href={`${base}how-it-works/#audience-comparison`}>Compare the two workflows <span aria-hidden="true">→</span></a></p>
        </div>
      </section>

      <section class="sx-cta" id="get-started">
        <div class="shell">
          <div class="sx-cta-inner closing-inner">
            <div>
              <p class="sx-kicker sx-kicker-light">FIND YOUR WAY INTO GRISTORA</p>
              <h2>Make every brew <em>more considered.</em></h2>
              <p>Choose the brewing path that reflects the way you work, compare the functions and explore the plans.</p>
            </div>
            <div class="sx-cta-actions">
              <a class="button button-primary" href={`${base}breweries/`}>Explore professional breweries <span aria-hidden="true">↗</span></a>
              <a class="sx-light-link" href={`${base}homebrewers/`}>For homebrewers <span aria-hidden="true">→</span></a>
              <a class="sx-light-link" href={`${base}pricing/`}>View plans & pricing <span aria-hidden="true">→</span></a>
              <a class="sx-light-link" href={`${base}compare/`}>Compare Home and Brewery functions <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-main">
        <a class="wordmark footer-wordmark" href="#top"><img class="brand-symbol" src={`${base}brand/gristora-symbol.svg`} alt="" aria-hidden="true" /><span class="wordmark-text">GRISTORA</span></a>

        <a class="back-top" href="#top">Back to top ↑</a>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} GRISTORA</span>
        <span>Made for the craft of brewing.</span>
      </div>
    </footer>
  </body>
</html>
