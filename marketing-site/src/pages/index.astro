---
import ProductScreens from "../components/ProductScreens.astro";
import PagePhoto from "../components/PagePhoto.astro";
import FontPreload from "../components/FontPreload.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import "../styles/home-hero-refinement.css";
import "../styles/stitch-layout.css";
import { features } from "../data/features";

const businessSpecificAreas = features.filter((feature) => feature.audiences.length === 1 && feature.audiences.includes("Breweries"));
const sharedBusinessAreas = features.filter((feature) => feature.audiences.length > 1 && feature.audiences.includes("Breweries"));
const featuredAreas = [...businessSpecificAreas, ...sharedBusinessAreas].slice(0, 6);

const homebrewerAreas = features.filter((feature) => feature.audiences.includes("Homebrewers")).slice(0, 4);

const base = import.meta.env.BASE_URL;
const allowIndexing = new URL(import.meta.env.SITE).hostname === "gristora.com";
const canonicalUrl = new URL(base, import.meta.env.SITE).href;
const pageTitle = "GRISTORA · Brewery Production Software";
const description = "GRISTORA is in development for brewing teams who want to track recipe targets, brew day measurements and batch records together.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "GRISTORA",
  url: canonicalUrl,
  description,
  inLanguage: "en",
};

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <FontPreload />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GRISTORA" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <main id="main-content">
      <section class="sx-hero sx-home-hero">
        <PagePhoto name="home-hero" lang="en" eager class="sx-home-hero-photo" />
        <div class="sx-home-hero-shade" aria-hidden="true"></div>
        <div class="sx-home-hero-content">
          <SiteHeader home />
          <div class="shell sx-hero-grid sx-home-hero-grid">
          <div class="hero-copy sx-hero-copy">
            <div class="sx-chip-row">
              <p class="sx-chip sx-chip-amber"><span class="sx-dot" aria-hidden="true"></span> BREWING INTELLIGENCE</p>
            </div>

            <h1>From recipe to batch record</h1>
            <p class="hero-intro">{description}</p>
            <div class="hero-actions">
              <a class="button button-primary" href={`${base}breweries/`}>For brewery teams <span aria-hidden="true">↗</span></a>
              <a class="hero-secondary" href={`${base}homebrewers/`}>For homebrewers <span aria-hidden="true">→</span></a>
            </div>
          </div>


          </div>
        </div>
      </section>

      <section class="sx-band section-pad" id="approach">
        <div class="shell">
          <div class="sx-heading">
            <h2>Inside one batch record</h2>
            <p>Follow the planned workflow for one pale ale. The figures are illustrative.</p>
          </div>
          <ol class="sx-card-grid sx-cols-4 batch-example">
            <li class="sx-card">
              <h3>Recipe target</h3>
              <p>The pale ale recipe calls for a 500-litre batch.</p>
              <a class="text-link" href={`${base}features/recipe-design/`}>Recipe design</a>
            </li>
            <li class="sx-card">
              <h3>Brew day</h3>
              <p>The team records 490 litres transferred to the fermenter.</p>
              <a class="text-link" href={`${base}features/brew-day/`}>Brew day records</a>
            </li>
            <li class="sx-card">
              <h3>Fermentation</h3>
              <p>On day two, the team records a temperature of 19 °C in the same tank.</p>
              <a class="text-link" href={`${base}features/fermentation-monitoring/`}>Fermentation monitoring</a>
            </li>
            <li class="sx-card">
              <h3>Batch review</h3>
              <p>The brewer compares the 500-litre target with the recorded transfer of 490 litres.</p>
              <a class="text-link" href={`${base}features/production-management/`}>Production management</a>
            </li>
          </ol>
        </div>
      </section>

      <ProductScreens page="home" lang="en" />
      <section class="sx-quote-wrap">
        <div class="shell">
          <div class="sx-quote">
            <p class="sx-kicker sx-kicker-light">A TECHNICAL APPROACH</p>
            <h2>Numbers should be <em>understood,</em> not just displayed.</h2>
            <p>Brewing calculations deserve clear terminology, consistent units and an explanation of what sits behind the result. That is the standard GRISTORA is designed to follow.</p>
            <a class="sx-light-link" href={`${base}technical-principles/`}>Discover the GRISTORA approach <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="section-pad" id="product-depth">
        <div class="shell">
          <div class="sx-heading sx-heading-split">
            <div>
              <p class="sx-kicker">THE PRODUCT, IN DEPTH</p>
              <h2>More than recipes. <em>A connected brewing workflow, designed for brewing teams.</em></h2>
            </div>
            <p>Explore the planned Business areas first, including production, quality and materials, followed by shared recipe and brewing workflows.</p>
          </div>
          <div class="sx-card-grid sx-cols-3">
            {featuredAreas.map((feature, index) => (
              <a class="sx-card sx-card-soft sx-card-link" href={`${base}features/${feature.slug}/`}>
                <span class="sx-num">{String(index + 1).padStart(2, "0")}</span>
                <p class="sx-card-kicker">{feature.eyebrow}</p>
                <h3>{feature.title}</h3>
                <p class="sx-card-foot">EXPLORE <span aria-hidden="true">↗</span></p>
              </a>
            ))}
          </div>
          <p class="sx-more"><a class="text-link" href={`${base}features/`}>Explore all product features <span aria-hidden="true">→</span></a></p>
        </div>
      </section>

      <section class="sx-band section-pad" id="audience-paths">
        <div class="shell">
          <div class="sx-heading sx-heading-center">
            <p class="sx-kicker">TWO WAYS TO BREW</p>
            <h2>Built around professional brewing. <em>Open to every brewer.</em></h2>
            <p>Start with the operational needs of your brewery, or explore the separate Homebrewers path.</p>
          </div>
          <div class="sx-audience-grid">
            <article class="sx-audience" id="breweries">
              <div class="sx-audience-top"><span class="sx-pill sx-pill-dark">PRIMARY AUDIENCE</span><span class="sx-meta">PROFESSIONAL BREWERIES</span></div>
              <h3>Bring consistency to every batch.</h3>
              <p>A planned technical workspace shaped around recipe standards, production context and reliable batch records for brewing teams.</p>
              <ul class="sx-checks" aria-label="Brewery areas">
                {businessSpecificAreas.slice(0, 4).map((feature) => <li>{feature.title}</li>)}
              </ul>
              <div class="sx-audience-foot"><div><span>PATH</span><strong>Professional Breweries</strong></div><a class="text-link" href={`${base}breweries/`}>Explore the brewery workflow <span aria-hidden="true">↗</span></a></div>
            </article>
            <article class="sx-audience" id="homebrewers">
              <div class="sx-audience-top"><span class="sx-pill">SECONDARY PATH</span><span class="sx-meta">HOMEBREWERS</span></div>
              <h3>Make room for better brewing.</h3>
              <p>A separate path for homebrewers exploring recipes, brewing calculations and the decisions behind every brew.</p>
              <ul class="sx-checks" aria-label="Homebrewing areas">
                {homebrewerAreas.map((feature) => <li>{feature.title}</li>)}
              </ul>
              <div class="sx-audience-foot"><div><span>PATH</span><strong>Homebrewers</strong></div><a class="text-link" href={`${base}homebrewers/`}>Explore homebrewing <span aria-hidden="true">↗</span></a></div>
            </article>
          </div>
          <p class="audience-compare-link"><a class="text-link" href={`${base}how-it-works/#audience-comparison`}>Compare the two workflows <span aria-hidden="true">→</span></a></p>
        </div>
      </section>

      <section class="sx-cta" id="get-started">
        <div class="shell">
          <div class="sx-cta-inner closing-inner">
            <div>
              <h2>Explore the plans</h2>
              <p>Compare the planned scope for individual homebrewers and professional brewery teams.</p>
            </div>
            <div class="sx-cta-actions">
              <a class="button button-primary" href={`${base}pricing/`}>View plan options</a>
              <a class="sx-light-link" href={`${base}compare/`}>Compare plan features</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-main">
        <a class="wordmark footer-wordmark" href="#top"><img class="brand-symbol" src={`${base}brand/gristora-symbol.svg`} width="130" height="160" alt="" aria-hidden="true" /><span class="wordmark-text">GRISTORA</span></a>

        <a class="back-top" href="#top">Back to top ↑</a>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} GRISTORA</span>
        <span>Made for the craft of brewing.</span>
      </div>
    </footer>
  </body>
</html>
