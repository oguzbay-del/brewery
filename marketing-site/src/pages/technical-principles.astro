---
import ProductScreens from "../components/ProductScreens.astro";
import PagePhoto from "../components/PagePhoto.astro";
import FontPreload from "../components/FontPreload.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildBreadcrumbList } from "../data/breadcrumbs";
import "../styles/learning-pages.css";
import "../styles/stitch-layout.css";

const base = import.meta.env.BASE_URL;
const allowIndexing = new URL(import.meta.env.SITE).hostname === "gristora.com";
const canonicalUrl = new URL(`${base}technical-principles/`, import.meta.env.SITE).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Brewing Calculations & Measurement Principles | GRISTORA",
  description: "The design principles intended to guide GRISTORA's planned brewing calculations, measurements and production records.",
  url: canonicalUrl,
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", name: "GRISTORA", url: new URL(base, import.meta.env.SITE).href },
};
const principles = [
  { number: "01", title: "Explain the method", body: "A technical result should be accompanied by its method, inputs, units, assumptions, example and limitations. A number without context is difficult to review or reproduce." },
  { number: "02", title: "Make units explicit", body: "The intended approach is to use consistent internal values and regional display. Technical guidance is intended to distinguish US customary, Imperial and metric units where relevant and explain conversions clearly." },
  { number: "03", title: "Separate target from actual", body: "A recipe target is not a measurement. Planned values and observed results should remain distinguishable so that a batch record reflects what happened rather than silently rewriting the recipe." },
  { number: "04", title: "Keep measurement context", body: "Manual, paper and connected-device readings have different origins and limitations. The planned record model is intended to keep source and context visible wherever those inputs are supported." },
  { number: "05", title: "Validate before estimating", body: "Calculation methods require reference cases and real brewing data." },
  { number: "06", title: "Keep people in control", body: "The design principle is that estimates should support a brewer's review, not silently change recipes, equipment profiles or process settings. A process change should require an explicit user decision." },
];
const breadcrumbItems = [{ name: "Home", url: new URL(base, import.meta.env.SITE).href }, { name: "Technical principles", url: canonicalUrl }];
const breadcrumbData = buildBreadcrumbList(breadcrumbItems);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <FontPreload />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content="Explore the design principles intended to guide GRISTORA's planned brewing calculations, units, measurements and production records." />
    <title>Brewing Calculations & Measurement Principles | GRISTORA</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GRISTORA" />
    <meta property="og:title" content="Brewing Calculations & Measurement Principles | GRISTORA" />
    <meta property="og:description" content="Methods, units, measurements and validation, with their intended scope and limitations." />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Brewing Calculations & Measurement Principles | GRISTORA" />
    <meta name="twitter:description" content="Methods, units, measurements and validation—explained with their limits." />
    <meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader current="principles" />
    <main id="main-content" class="principles-page">
      <Breadcrumbs items={breadcrumbItems} />
      <section class="shell explain-page-hero">
        <p class="eyebrow"><span class="eyebrow-line"></span> METHODS · MEASUREMENTS · VALIDATION</p>
        <h1>Technical clarity is <em>part of the craft.</em></h1>
        <p>GRISTORA is designed around brewing information that can be understood, checked and discussed. These principles describe the standard it sets.</p>
      </section>
      <div class="page-photo-band"><PagePhoto name="technical-principles-hero" lang="en" eager /></div>
      <section class="principles-section section-pad">
        <div class="shell">
          <div class="section-heading"><p class="eyebrow"><span class="eyebrow-line"></span> DESIGN PRINCIPLES</p><h2>Trust comes from <em>showing the work.</em></h2><p>Good technical software makes assumptions visible and leaves room for human judgement.</p></div>
          <ol class="principle-grid">
            {principles.map((item) => <li class="principle-card"><span>{item.number}</span><h2>{item.title}</h2><p>{item.body}</p></li>)}
          </ol>
        </div>
      </section>
      <ProductScreens page="technical-principles" lang="en" />
      <section class="validation-section section-pad">
        <div class="shell validation-layout">
          <div><p class="eyebrow"><span class="eyebrow-line"></span> BEFORE A TECHNICAL CLAIM IS PUBLISHED</p><h2>Evidence before <em>confidence.</em></h2></div>
          <div><p>Each public calculation or technical guide should be reviewed against a repeatable evidence checklist:</p><ul><li>Named method and authoritative reference.</li><li>Inputs, units, defaults and assumptions.</li><li>Worked example with expected result and tolerance.</li><li>Known limitations and conditions where the method should not be used.</li><li>Reviewer, validation date and version of the method or engine.</li></ul></div>
        </div>
      </section>
      <section class="technical-visual shell">
        <div class="visual-grid">
          <figure class="visual-diagram"><img src={`${base}images/diagrams/fermentation-profile-example.svg`} width="960" height="520" alt="Specific-gravity fermentation curve over twelve days with example values." loading="lazy" /><figcaption>Example data for explanation</figcaption></figure>
          <figure class="visual-diagram"><img src={`${base}images/diagrams/target-vs-actual-example.svg`} width="960" height="520" alt="Chart separating a target line from actual brewing measurement points." loading="lazy" /><figcaption>Target and actual values shown separately · example data</figcaption></figure>
        </div>
        <figure class="visual-diagram measurement-visual"><img src={`${base}images/diagrams/measurement-source-context.svg`} width="960" height="520" alt="Illustrative comparison of manual notes, instrument readings and device readings, with timestamp, unit, method, source and calibration context." loading="lazy" /><figcaption>Measurement-source principle · context the planned record model is intended to preserve</figcaption></figure>
        <figure class="visual-diagram visual-diagram-scroll" role="region" aria-label="Scrollable equipment calibration record diagram" tabindex="0"><img src={`${base}images/diagrams/calibration-record-model.svg`} width="1100" height="520" alt="Illustrative planned equipment calibration record model linking an instrument, reference standard, test reading, tolerance review and recorded status, with no automated recommendation." loading="lazy" /><figcaption>Swipe or scroll to inspect the example record model</figcaption></figure>
      </section>
      <section class="explain-disclaimer section-pad"><div class="shell"><p class="eyebrow"><span class="eyebrow-line"></span> CONTINUE EXPLORING</p><h2>See how the principles map to <em>real brewing work.</em></h2><p>Homebrewers and professional breweries have different workflows. Explore each path and the product areas.</p><div class="principles-actions"><a class="button button-primary" href={`${base}how-it-works/`}>How it works <span aria-hidden="true">↗</span></a><a class="text-link" href={`${base}features/`}>Explore product areas <span aria-hidden="true">→</span></a></div></div></section>
    </main>
    <SiteFooter />
  </body>
</html>
