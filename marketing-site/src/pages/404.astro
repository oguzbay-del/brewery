---
import PagePhoto from "../components/PagePhoto.astro";
import FontPreload from "../components/FontPreload.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import "../styles/stitch-layout.css";

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <FontPreload />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content="The page you are looking for could not be found. Return to GRISTORA to explore brewing software for professional breweries and homebrewers." />
    <title>Page not found | GRISTORA</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content" class="not-found-page">
     <div class="not-found shell">
      <div class="not-found-disc" aria-hidden="true"><img src={`${base}brand/gristora-symbol.svg`} alt="" width="130" height="160" /></div>
      <p class="eyebrow not-found-chip">404 · PAGE NOT FOUND</p>
      <h1>This page seems to have <em>gone off the boil.</em></h1>
      <p>The address may be out of date, or the page may have moved. Head back to GRISTORA and choose the brewing path that fits you.</p>
      <div class="not-found-actions">
        <a class="button button-primary" href={base}>Back to GRISTORA <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={`${base}breweries/`}>Professional breweries</a>
        <a class="text-link" href={`${base}homebrewers/`}>Homebrewers</a>
      </div>
     </div>
     <div class="page-photo-band"><PagePhoto name="404" /></div>
    </main>
    <SiteFooter backText="All features ↑" backHref={`${base}features/`} />
  </body>
</html>
