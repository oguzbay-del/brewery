---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>Page not found — GRISTORA</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="GRISTORA home"><img class="brand-symbol" src={`${base}brand/gristora-symbol.svg`} alt="" aria-hidden="true" /><span class="wordmark-text">GRISTORA</span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href={`${base}features/`}>Product</a>
        <a href={`${base}breweries/`}>Breweries</a>
        <a href={`${base}homebrewers/`}>Homebrewers</a>
        <a href={`${base}pricing/`}>Pricing</a><a href={`${base}how-it-works/`}>How it works</a>
        <a href={`${base}technical-principles/`}>Principles</a>
        <a href={`${base}faq/`}>FAQ</a>
      </nav>
      <a class="header-cta" href={`${base}breweries/`}>Explore breweries <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu">
        <summary aria-label="Open navigation menu"><span></span><span></span></summary>
        <nav aria-label="Mobile navigation">
          <a href={`${base}features/`}>Product</a>
          <a href={`${base}breweries/`}>Breweries</a>
          <a href={`${base}homebrewers/`}>Homebrewers</a>
          <a href={`${base}pricing/`}>Pricing</a><a href={`${base}how-it-works/`}>How it works</a>
          <a href={`${base}technical-principles/`}>Technical principles</a>
          <a href={`${base}faq/`}>FAQ</a>
        </nav>
      </details>
    </header>
    <main id="main-content" class="not-found shell">
      <p class="eyebrow"><span class="eyebrow-line"></span> 404 · PAGE NOT FOUND</p>
      <h1>This page seems to have <em>gone off the boil.</em></h1>
      <p>The address may be out of date, or the page may have moved. Head back to GRISTORA and choose the brewing path that fits you.</p>
      <div class="not-found-actions">
        <a class="button button-primary" href={base}>Back to GRISTORA <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={`${base}breweries/`}>Professional breweries</a>
        <a class="text-link" href={`${base}homebrewers/`}>Homebrewers</a>
      </div>
    </main>
    <footer class="site-footer">
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} GRISTORA</span>
        <span>Made for the craft of brewing.</span>
      </div>
    </footer>
  </body>
</html>
