---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f2f7" />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>Page not found — Demleme</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Demleme home">demleme<span>.</span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href={`${base}homebrewers/`}>Homebrewers</a>
        <a href={`${base}breweries/`}>Breweries</a>
      </nav>
    </header>
    <main id="main-content" class="not-found shell">
      <p class="eyebrow"><span class="eyebrow-line"></span> 404 · PAGE NOT FOUND</p>
      <h1>This page seems to have <em>gone off the boil.</em></h1>
      <p>The address may be out of date, or the page may have moved. Head back to Demleme and choose the brewing path that fits you.</p>
      <div class="not-found-actions">
        <a class="button button-primary" href={base}>Back to Demleme <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={`${base}homebrewers/`}>Homebrewers</a>
        <a class="text-link" href={`${base}breweries/`}>Professional breweries</a>
      </div>
    </main>
    <footer class="site-footer">
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} Demleme</span>
        <span>Made for the craft of brewing.</span>
      </div>
    </footer>
  </body>
</html>
