---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildBreadcrumbList } from "../data/breadcrumbs";
import "../styles/audience-pages.css";
import "../styles/learning-pages.css";
import "../styles/stitch-layout.css";

const base = import.meta.env.BASE_URL;
const allowIndexing = new URL(import.meta.env.SITE).hostname === "gristora.com";
const canonicalUrl = new URL(`${base}faq/`, import.meta.env.SITE).href;
const groups = [
  {
    title: "About GRISTORA",
    items: [
      { q: "What is GRISTORA?", a: "GRISTORA is brewing software with professional breweries as its primary commercial audience and a separate Homebrewers path." },
      { q: "Who is GRISTORA designed for?", a: "Professional brewery teams are the primary commercial audience. Homebrewers remain a distinct secondary audience, with their own recipe, brew-day and batch-review journey." },
    ],
  },
  {
    title: "Product scope",
    items: [
      { q: "Does GRISTORA replace a brewery ERP?", a: "No. GRISTORA is focused on brewing-related recipe, batch and production information. It is not a general ERP." },
      { q: "Does it manage sales, orders, distribution or keg tracking?", a: "No. Sales, customer orders, distribution and shipping, keg tracking, CRM and accounting are outside the stated product scope." },
    ],
  },
  {
    title: "Technical questions",
    items: [
      { q: "Does GRISTORA offer APIs, webhooks and device integrations?", a: "Business mode includes an open API and production-data webhooks. Homebrew mode supports Tilt hydrometers, iSpindel and RAPT devices, plus a webhook data endpoint for compatible bridges." },
      { q: "Where can I read about methods and units?", a: "The Technical Principles page explains the approach to methods, units, measurements and validation." },
    ],
  },
  {
    title: "Commercial information",
    items: [
      { q: "What does GRISTORA cost? Is there a free plan or trial?", a: "The pricing page describes separate Homebrewer and Professional Brewery plan structures, with a one-user Home plan and Business seats in groups of five up to 20. Proposed trial terms are three months for Home and one month for Brewery, but neither trial is active in this preview. Proposed billing discounts are shown for comparison only; final commercial terms and monetary prices are not approved. You can configure a plan without creating an account or making a payment." },
    ],
  },
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  name: "Frequently Asked Questions — GRISTORA",
  description: "Answers for professional brewery teams about GRISTORA's brewing software scope and separate Homebrewers path.",
  url: canonicalUrl,
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", name: "GRISTORA", url: new URL(base, import.meta.env.SITE).href },
  mainEntity: groups.flatMap((group) =>
    group.items.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    }))
  ),
};
const breadcrumbItems = [{ name: "Home", url: new URL(base, import.meta.env.SITE).href }, { name: "FAQ", url: canonicalUrl }];
const breadcrumbData = buildBreadcrumbList(breadcrumbItems);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content="Answers for professional brewery teams about GRISTORA's brewing software scope and the separate Homebrewers path." />
    <title>GRISTORA Brewing Software FAQ for Breweries | Product Scope</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GRISTORA" />
    <meta property="og:title" content="GRISTORA Brewing Software FAQ for Breweries | Product Scope" />
    <meta property="og:description" content="Clear answers for professional brewery teams on the product, brewing scope and technical approach." />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="GRISTORA Brewing Software FAQ for Breweries | Product Scope" />
    <meta name="twitter:description" content="Clear answers for professional brewery teams on the product, brewing scope and technical approach." />
    <meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader current="faq" />
    <main id="main-content" class="faq-page">
      <Breadcrumbs items={breadcrumbItems} />
      <section class="shell explain-page-hero">
        <p class="eyebrow"><span class="eyebrow-line"></span> PRODUCT · SCOPE · TECHNICAL APPROACH</p>
        <h1>Good questions deserve <em>clear answers.</em></h1>
        <p>Professional brewery teams are GRISTORA's primary audience. Homebrewers have a separate secondary path.</p>
      </section>
      <section class="faq-directory section-pad">
        <div class="shell faq-directory-layout">
          <aside class="faq-directory-aside"><p class="eyebrow"><span class="eyebrow-line"></span> QUICK CONTEXT</p><h2>Methods and units, <em>explained plainly.</em></h2><p>The technical principles explain how GRISTORA treats methods, units and measurements.</p><a class="text-link" href={`${base}technical-principles/`}>Read technical principles <span aria-hidden="true">→</span></a></aside>
          <div class="faq-groups">
            {groups.map((group, index) => (
              <section class="faq-group">
                <p class="eyebrow">{String(index + 1).padStart(2, "0")} · {group.title.toUpperCase()}</p>
                <div class="audience-faq-list">{group.items.map((item) => <details class="audience-faq-item"><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
              </section>
            ))}
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>
