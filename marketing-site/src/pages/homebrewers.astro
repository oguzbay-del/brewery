---
import PagePhoto from "../components/PagePhoto.astro";
import FontPreload from "../components/FontPreload.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildBreadcrumbList } from "../data/breadcrumbs";
import "../styles/audience-pages.css";
import "../styles/stitch-layout.css";
import "../styles/pricing.css";
import { features } from "../data/features";

const homeAreas = features.filter((feature) => feature.audiences.includes("Homebrewers"));
const base = import.meta.env.BASE_URL;
const allowIndexing = new URL(import.meta.env.SITE).hostname === "gristora.com";
const canonicalUrl = new URL(`${base}homebrewers/`, import.meta.env.SITE).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Homebrewing Software | GRISTORA",
  url: canonicalUrl,
  description: "Brewing software being designed for homebrewers who want to understand the details behind every batch.",
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", name: "GRISTORA", url: new URL(base, import.meta.env.SITE).href },
};
const workflow = [
  { number: "01", title: "Shape the recipe", question: "What are you trying to brew?", body: "The planned workflow starts with the style, ingredients, equipment and batch size that define a recipe, with the choices and their context kept together.", feature: "Recipe design & management", href: "recipe-design" },
  { number: "02", title: "Understand ingredients and water", question: "What is going into the batch?", body: "The planned recipe view is intended to bring fermentables, hops, yeast, water assumptions and mash choices into the same picture.", feature: "Water, mash & yeast", href: "water-mash-yeast" },
  { number: "03", title: "Make sense of the numbers", question: "How do the estimates relate to your recipe?", body: "The planned calculation approach is intended to make inputs, units, methods and assumptions explicit.", feature: "Brewing calculations", href: "brewing-calculations" },
  { number: "04", title: "Record brew day", question: "What actually happened?", body: "The planned workflow is intended to separate recipe targets from actual quantities, times, temperatures and measurements recorded during the brew.", feature: "Brew day & production records", href: "brew-day" },
  { number: "05", title: "Follow fermentation", question: "What are you observing over time?", body: "The planned batch timeline is intended to keep manual observations and, subject to implementation, connected readings together.", feature: "Fermentation & batch tracking", href: "fermentation-monitoring" },
  { number: "06", title: "Review the batch", question: "What would you carry into the next brew?", body: "The planned review is intended to bring measurements, recipe context and tasting notes together to help explain differences between batches.", feature: "Reports, insights & sustainability", href: "analytics-reports" },
];
const faqs = [
  { q: "Which brewing calculations are supported?", a: "The planned Homebrewers path is intended to explain gravity, alcohol, bitterness, colour, mash and volume calculations with explicit inputs, units and methods. Results require validation before they can be described as supported or accurate." },
  { q: "Can I connect a fermentation device?", a: "Device connectivity is a roadmap area. The initial direction is read-only fermentation data; named device and bridge compatibility will be confirmed only after implementation and testing." },
  { q: "Can I import or export my existing recipes?", a: "Recipe import and export are roadmap items. Supported formats will be listed only after each implementation is verified." },
];
const breadcrumbItems = [{ name: "Home", url: new URL(base, import.meta.env.SITE).href }, { name: "Homebrewers", url: canonicalUrl }];
const breadcrumbData = buildBreadcrumbList(breadcrumbItems);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <FontPreload />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content="Explore the planned GRISTORA Homebrewers direction: recipe design, ingredient context, calculations, brew-day records and batch review." />
    <title>Homebrewing Software | GRISTORA</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GRISTORA" />
    <meta property="og:title" content="Homebrewing Software | GRISTORA" />
    <meta property="og:description" content="A more considered approach to every brew. Explore the GRISTORA homebrewing workflow." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Homebrewing Software | GRISTORA" />
    <meta name="twitter:description" content="A more considered approach to every brew." />
    <meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader current="homebrewers" />
    <main id="main-content">
      <div class="sx-audience-band">
      <Breadcrumbs items={breadcrumbItems} />
      <section class="shell audience-page-intro">
        <p class="eyebrow"><span class="eyebrow-line"></span> FOR HOME BREWERS</p>
        <h1>A more considered approach to <em>every brew.</em></h1>
        <p>GRISTORA is being designed as brewing software for homebrewers who want to understand the ingredients, calculations and observations behind each batch.</p>
        <a class="button button-primary" href="#homebrewing-workflow">Explore the homebrewing workflow <span aria-hidden="true">↗</span></a>
      </section>
      <section class="shell audience-hero">
        <PagePhoto name="homebrewers-hero" lang="en" eager class="audience-hero-photo" />
      </section>
      </div>
      <section class="audience-page-section section-pad" id="homebrewing-workflow">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> THE HOMEBREWING WORKFLOW</p>
            <h2>A brew is a series of <em>connected decisions.</em></h2>
            <p>Follow the work from recipe idea to batch review.</p>
          </div>
          <ol class="workflow-grid">
            {workflow.map((step) => (
              <li class="workflow-card">
                <span class="workflow-number">{step.number}</span>
                <h3>{step.title}</h3>
                <p class="workflow-question">{step.question}</p>
                <p>{step.body}</p>
                <a href={`${base}features/${step.href}/`}>{step.feature} <span aria-hidden="true">↗</span></a>
              </li>
            ))}
          </ol>
        </div>
      </section>
      <section class="home-record-section section-pad">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> THE HOME BREW RECORD LOOP</p>
            <h2>Keep the story of <em>your brew together.</em></h2>
            <p>For a homebrewer, useful history starts with the recipe and continues through the measurements and decisions made along the way.</p>
          </div>
          <div class="role-table-wrap" role="region" aria-label="Scrollable Homebrew record loop table" tabindex="0">
            <table class="role-table home-record-table">
              <thead><tr><th scope="col">Part of the brew</th><th scope="col">What belongs in the record</th><th scope="col">What it helps you understand</th></tr></thead>
              <tbody>
                <tr><th scope="row">Recipe and targets</th><td>Recipe version, style, batch size, equipment assumptions and target values.</td><td>Which plan you started from, and what you intended to make.</td></tr>
                <tr><th scope="row">Ingredients and water</th><td>Ingredient choices, quantities, source-water information and selected adjustments.</td><td>Which inputs shaped the recipe and its calculated expectations.</td></tr>
                <tr><th scope="row">Brew-day actuals</th><td>Measured volumes, temperatures, times, additions and differences from the plan.</td><td>Where the real brew differed from the recipe assumptions.</td></tr>
                <tr><th scope="row">Fermentation observations</th><td>Manual readings and, if implemented, supported-device gravity and temperature readings, with their source identified.</td><td>How the batch changed over time.</td></tr>
                <tr><th scope="row">Tasting and review</th><td>Packaging context, tasting notes and a comparison with the original targets.</td><td>What you learned and what you may choose to change next time.</td></tr>
              </tbody>
            </table>
          </div>
          <p class="record-model-note">The Homebrew path is centred on an individual brewer's recipe, measurements and learning loop. Professional lot traceability, vessel occupancy, shift handover and quality-release workflows belong to Business mode.</p>
          <figure class="visual-diagram"><img src={`${base}images/diagrams/homebrew-ingredient-context.svg`} width="960" height="460" alt="Homebrew path from recipe ingredient specification through selected inputs and brew-day quantities to batch review." loading="lazy" /><figcaption>Ingredient context across a homebrew batch</figcaption></figure>
          <figure class="visual-diagram visual-diagram-scroll" role="region" aria-label="Scrollable fermentation observation timeline" tabindex="0"><img src={`${base}images/diagrams/fermentation-observation-timeline.svg`} width="1100" height="500" alt="Six-point fermentation observation timeline with example values showing specific gravity, temperature and notes at each day, with timestamp and manual sample context." loading="lazy" /><figcaption>Swipe or scroll to inspect each observation · example values</figcaption></figure>
        </div>
      </section>
      <section class="audience-feature-section section-pad">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> PLANNED PRODUCT AREAS</p>
            <h2>Explore the work behind <em>the brew.</em></h2>
            <p>Every capability is described with its intended audience.</p>
          </div>
          <div class="audience-feature-grid">
            {homeAreas.map((feature) => (
              <a class="audience-feature-link" href={`${base}features/${feature.slug}/`}>
                <span>{feature.eyebrow}</span><strong>{feature.title}</strong><small>Explore planned scope ↗</small>
              </a>
            ))}
          </div>
        </div>
      </section>
      <section class="technical-clarity-section section-pad">
        <div class="shell technical-clarity-grid">
          <div><p class="eyebrow"><span class="eyebrow-line"></span> TECHNICAL CLARITY</p><h2>Understand the number, <em>not just the result.</em></h2></div>
          <div><p>A calculation or technical guide explains its method, inputs, units, assumptions, worked example and limitations together.</p><p>The planned calculation experience is intended to show its method, inputs and units.</p><a class="text-link" href={`${base}features/brewing-calculations/`}>Read about brewing calculations <span aria-hidden="true">→</span></a></div>
        </div>
      </section>
      <section class="audience-faq-section section-pad">
        <div class="shell audience-faq-layout">
          <div class="section-heading"><p class="eyebrow"><span class="eyebrow-line"></span> HOME BREWER FAQ</p><h2>Clear answers for <em>curious brewers.</em></h2></div>
          <div class="audience-faq-list">
            {faqs.map((faq) => <details class="audience-faq-item"><summary>{faq.q}</summary><p>{faq.a}</p></details>)}
          </div>
        </div>
      </section>
      <section class="closing-section section-pad"><div class="shell closing-inner"><p class="eyebrow"><span class="eyebrow-line"></span> THE CRAFT IS IN THE DETAILS</p><h2>Keep learning with <em>every batch.</em></h2><a class="button button-primary" href={`${base}how-it-works/#home-workflow`}>Explore the homebrewing workflow <span aria-hidden="true">↗</span></a></div></section>

      <section class="pricing-cta section-pad">
        <div class="shell pricing-cta-inner">
          <p class="eyebrow"><span class="eyebrow-line"></span> CHOOSE YOUR PLAN</p>
          <h2>Find the right <em>brewing workspace.</em></h2>
          <p>Compare the Homebrewer and Professional Brewery paths, then configure a plan step by step.</p>
          <a class="button button-primary" href={`${base}pricing/`}>View plans & pricing <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={`${base}compare/`}>Compare functions <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>
