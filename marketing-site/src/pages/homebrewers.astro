---
import "../styles/global.css";
import "../styles/audience-pages.css";
import { features } from "../data/features";

const homeAreas = features.filter((feature) => feature.audiences.includes("Homebrewers"));
const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(`${base}homebrewers/`, import.meta.env.SITE).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "For Homebrewers — Demleme",
  url: canonicalUrl,
  description: "Brewing software in development for homebrewers who want to understand the details behind every batch.",
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", name: "Demleme", url: new URL(base, import.meta.env.SITE).href },
};
const workflow = [
  { number: "01", title: "Shape the recipe", question: "What are you trying to brew?", body: "Start with the style, ingredients, equipment and batch size that define your recipe. Keep the choices and their context together.", feature: "Recipe design & management", href: "recipe-design" },
  { number: "02", title: "Understand ingredients and water", question: "What is going into the batch?", body: "Bring fermentables, hops, yeast, water assumptions and mash choices into the same recipe picture.", feature: "Water, mash & yeast", href: "water-mash-yeast" },
  { number: "03", title: "Make sense of the numbers", question: "How do the estimates relate to your recipe?", body: "Brewing calculations are planned with explicit inputs, units, methods and assumptions. Each method must be validated before public use.", feature: "Brewing calculations", href: "brewing-calculations" },
  { number: "04", title: "Record brew day", question: "What actually happened?", body: "The planned workflow separates recipe targets from actual quantities, times, temperatures and measurements recorded during the brew.", feature: "Brew day & production records", href: "brew-day" },
  { number: "05", title: "Follow fermentation", question: "What are you observing over time?", body: "The roadmap includes batch timelines and manual or connected readings. Predictive finish-date and final-gravity models are not approved capabilities.", feature: "Fermentation & batch tracking", href: "fermentation-monitoring" },
  { number: "06", title: "Review the batch", question: "What would you carry into the next brew?", body: "Bring measurements, recipe context and tasting notes together to understand differences between batches. Advanced analytical insights remain separately gated.", feature: "Reports, insights & sustainability", href: "analytics-reports" },
];
const faqs = [
  { q: "Is Demleme available to use today?", a: "No. Demleme and this marketing website are in development. The pages describe the product plan, not a live service." },
  { q: "Which brewing calculations are supported?", a: "The product plan includes gravity, alcohol, bitterness, colour, mash and volume calculations. Methods, defaults and results must pass reference-recipe and real-brew validation before release." },
  { q: "Does Demleme predict fermentation outcomes?", a: "Final-gravity and fermentation finish-date estimates are under consideration and depend on an analytical model that has not been approved. They are not presented as available features." },
  { q: "Can I connect a fermentation device?", a: "Device connectivity is part of the product plan. Supported devices, setup instructions and availability will be stated only after implementation and validation." },
  { q: "Can I import or export my existing recipes?", a: "Recipe import and export formats are described in the roadmap. Compatibility and conversion behaviour must be verified before a format is advertised as supported." },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f2f7" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content="Explore Demleme's planned homebrewing workflow: recipe design, ingredients, calculations, brew-day records and batch review." />
    <title>For Homebrewers — Demleme</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Demleme" />
    <meta property="og:title" content="For Homebrewers — Demleme" />
    <meta property="og:description" content="A more considered approach to every brew. Explore the Demleme homebrewing roadmap." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="For Homebrewers — Demleme" />
    <meta name="twitter:description" content="A more considered approach to every brew." />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Demleme home">demleme<span>.</span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href={`${base}features/`}>Product</a>
        <a href={`${base}homebrewers/`}>Homebrewers</a>
        <a href={`${base}breweries/`}>Breweries</a>
        <a href={`${base}how-it-works/`}>How it works</a>
        <a href={`${base}technical-principles/`}>Principles</a><a href={`${base}faq/`}>FAQ</a>
      </nav>
      <a class="header-cta" href={`${base}#audience-paths`}>All brewing paths <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu"><summary aria-label="Toggle navigation menu"><span></span><span></span></summary><nav aria-label="Mobile navigation">
          <a href={`${base}features/`}>Product</a>
          <a href={`${base}homebrewers/`}>Homebrewers</a>
          <a href={`${base}breweries/`}>Breweries</a>
          <a href={`${base}how-it-works/`}>How it works</a>
          <a href={`${base}technical-principles/`}>Technical principles</a><a href={`${base}faq/`}>FAQ</a>
        </nav></details>
    </header>
    <main id="main-content">
      <section class="shell audience-page-intro">
        <p class="eyebrow"><span class="eyebrow-line"></span> FOR HOME BREWERS · IN DEVELOPMENT</p>
        <h1>A more considered approach to <em>every brew.</em></h1>
        <p>Demleme is brewing software in development for homebrewers who want to understand the ingredients, calculations and observations behind each batch.</p>
        <a class="button button-primary" href="#homebrewing-workflow">Explore the homebrewing workflow <span aria-hidden="true">↗</span></a>
      </section>
      <!-- IMAGE SLOT: HOMEBREWERS-HERO | Replace only with user-approved or licensed documentary photography. -->
      <section class="shell audience-hero">
        <div class="image-placeholder" data-image-slot="homebrewers-hero"><strong>IMAGE PLACEHOLDER · HOMEBREWERS-HERO</strong><span>Homebrewer measuring, preparing ingredients or working beside a small-batch setup</span></div>
      </section>
      <section class="audience-page-section section-pad" id="homebrewing-workflow">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> THE HOMEBREWING WORKFLOW</p>
            <h2>A brew is a series of <em>connected decisions.</em></h2>
            <p>Follow the work from recipe idea to batch review. Each area below describes planned product direction, not functionality available today.</p>
          </div>
          <ol class="workflow-grid">
            {workflow.map((step) => (
              <li class="workflow-card">
                <span class="workflow-number">{step.number}</span>
                <h3>{step.title}</h3>
                <p class="workflow-question">{step.question}</p>
                <p>{step.body}</p>
                <a href={`${base}features/${step.href}/`}>{step.feature} <span aria-hidden="true">↗</span></a>
              </li>
            ))}
          </ol>
        </div>
      </section>
      <section class="home-record-section section-pad">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> THE HOME BREW RECORD LOOP · ROADMAP</p>
            <h2>Keep the story of <em>your brew together.</em></h2>
            <p>For a homebrewer, useful history starts with the recipe and continues through the measurements and decisions made along the way. This is the intended Homebrew record loop, not a live feature claim.</p>
          </div>
          <div class="role-table-wrap">
            <table class="role-table home-record-table">
              <thead><tr><th scope="col">Part of the brew</th><th scope="col">What belongs in the record</th><th scope="col">What it helps you understand</th></tr></thead>
              <tbody>
                <tr><th scope="row">Recipe and targets</th><td>Recipe version, style, batch size, equipment assumptions and target values.</td><td>Which plan you started from, and what you intended to make.</td></tr>
                <tr><th scope="row">Ingredients and water</th><td>Ingredient choices, quantities, source-water information and selected adjustments.</td><td>Which inputs shaped the recipe and its calculated expectations.</td></tr>
                <tr><th scope="row">Brew-day actuals</th><td>Measured volumes, temperatures, times, additions and differences from the plan.</td><td>Where the real brew differed from the recipe assumptions.</td></tr>
                <tr><th scope="row">Fermentation observations</th><td>Manual or supported-device gravity and temperature readings, with their source identified.</td><td>How the batch changed over time without implying an unapproved prediction.</td></tr>
                <tr><th scope="row">Tasting and review</th><td>Packaging context, tasting notes and a comparison with the original targets.</td><td>What you learned and what you may choose to change next time.</td></tr>
              </tbody>
            </table>
          </div>
          <p class="record-model-note">The Homebrew roadmap is centred on an individual brewer's recipe, measurements and learning loop. Professional lot traceability, vessel occupancy, shift handover and quality-release workflows belong to the separate Business roadmap.</p>
        </div>
      </section>
      <section class="audience-feature-section section-pad">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> PRODUCT AREAS · ROADMAP</p>
            <h2>Explore the work behind <em>the brew.</em></h2>
            <p>Every capability is described with its intended audience and development stage. The product is not yet available.</p>
          </div>
          <div class="audience-feature-grid">
            {homeAreas.map((feature) => (
              <a class="audience-feature-link" href={`${base}features/${feature.slug}/`}>
                <span>{feature.eyebrow}</span><strong>{feature.title}</strong><small>Explore planned capabilities ↗</small>
              </a>
            ))}
          </div>
        </div>
      </section>
      <section class="technical-clarity-section section-pad">
        <div class="shell technical-clarity-grid">
          <div><p class="eyebrow"><span class="eyebrow-line"></span> TECHNICAL CLARITY</p><h2>Understand the number, <em>not just the result.</em></h2></div>
          <div><p>When a calculation or technical guide is published, it should explain its method, inputs, units, assumptions, worked example and limitations together. A result without its context is not enough.</p><p>Calculation methods and defaults remain subject to validation against reference recipes and real brewing data. Public calculators are not part of this release.</p><a class="text-link" href={`${base}features/brewing-calculations/`}>Read about planned brewing calculations <span aria-hidden="true">→</span></a></div>
        </div>
      </section>
      <section class="audience-faq-section section-pad">
        <div class="shell audience-faq-layout">
          <div class="section-heading"><p class="eyebrow"><span class="eyebrow-line"></span> HOME BREWER FAQ</p><h2>Clear answers for <em>curious brewers.</em></h2></div>
          <div class="audience-faq-list">
            {faqs.map((faq) => <details class="audience-faq-item"><summary>{faq.q}</summary><p>{faq.a}</p></details>)}
          </div>
        </div>
      </section>
      <section class="closing-section section-pad"><div class="shell closing-inner"><p class="eyebrow"><span class="eyebrow-line"></span> THE CRAFT IS IN THE DETAILS</p><h2>Keep learning with <em>every batch.</em></h2><a class="button button-primary" href={base}>Explore both brewing paths <span aria-hidden="true">↗</span></a></div></section>
    </main>
    <footer class="site-footer"><div class="shell footer-main"><a class="wordmark footer-wordmark" href={base}>demleme<span>.</span></a><p>Brewing software in development for people who care about the details.</p><a class="back-top" href={base}>Home ↑</a></div><div class="shell footer-bottom"><span>© {new Date().getFullYear()} Demleme</span><span>Made for the craft of brewing.</span></div></footer>
  </body>
</html>
