---
import "../styles/global.css";
import { features } from "../data/features";
const homeAreas = features.filter((feature) => feature.audiences.includes("Homebrewers"));

const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(`${base}homebrewers/`, import.meta.env.SITE).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "For Homebrewers — Demleme",
  url: canonicalUrl,
  description: "Brewing software in development for homebrewers who care about the details.",
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", name: "Demleme", url: new URL(base, import.meta.env.SITE).href },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f2f7" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content="Brewing software in development for homebrewers who care about the details." />
    <title>For Homebrewers — Demleme</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Demleme" />
    <meta property="og:title" content="For Homebrewers — Demleme" />
    <meta property="og:description" content="Brewing software in development for homebrewers who care about the details." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="For Homebrewers — Demleme" />
    <meta name="twitter:description" content="Brewing software in development for homebrewers who care about the details." />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Demleme home">demleme<span>.</span></a>
      <nav class="desktop-nav" aria-label="Main navigation"><a href={`${base}features/`}>Product</a><a href={`${base}homebrewers/`}>Homebrewers</a><a href={`${base}breweries/`}>Breweries</a><a href={`${base}#approach`}>Our approach</a></nav>
      <a class="header-cta" href={`${base}#audience-paths`}>All brewing paths <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu"><summary aria-label="Toggle navigation menu"><span></span><span></span></summary><nav aria-label="Mobile navigation"><a href={`${base}features/`}>Product features</a><a href={`${base}homebrewers/`}>Homebrewers</a><a href={`${base}breweries/`}>Breweries</a><a href={`${base}#approach`}>Our approach</a></nav></details>
    </header>
    <main id="main-content">
      <section class="shell audience-page-intro">
        <p class="eyebrow"><span class="eyebrow-line"></span> FOR HOME BREWERS · IN DEVELOPMENT</p>
        <h1>Make every brew a <em>learning experience.</em></h1>
        <p>Demleme is in development. We are shaping a technical brewing software experience for homebrewers who want to understand recipes, ingredients and the decisions behind each brew.</p>
        <a class="button button-primary" href="#homebrewing-focus">Explore the homebrewing focus <span aria-hidden="true">↗</span></a>
      </section>
      <!-- IMAGE SLOT: HOMEBREWERS-HERO | Replace placeholder with licensed documentary-style photo of a homebrewer working on a batch. -->
      <section class="shell audience-hero">
        <div class="image-placeholder" data-image-slot="homebrewers-hero"><strong>IMAGE PLACEHOLDER · HOMEBREWERS-HERO</strong><span>Homebrewer measuring, preparing ingredients or working beside a small-batch setup</span></div>
      </section>
      <section class="audience-page-section section-pad" id="homebrewing-focus">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> HOME BREWING · PRODUCT ROADMAP</p>
            <h2>A complete toolkit for your next brew.</h2>
            <p>Explore the planned capabilities for homebrewing—from recipe formulation and water chemistry to brew-day guidance, fermentation and learning from each batch.</p>
          </div>
          <div class="audience-feature-grid">
            {homeAreas.map((feature) => (
              <a class="audience-feature-link" href={`${base}features/${feature.slug}/`}>
                <span>{feature.eyebrow}</span><strong>{feature.title}</strong><small>Explore planned capabilities ↗</small>
              </a>
            ))}
          </div>
          <p class="audience-page-note" style="margin-top:28px">The Home mode is designed to keep advanced controls approachable, with selected advanced features available to enable when you need them.</p>
          <a class="text-link" style="margin-top:18px" href={`${base}features/`}>View the complete product feature catalogue <span aria-hidden="true">→</span></a>
        </div>
      </section>
      <section class="closing-section section-pad"><div class="shell closing-inner"><p class="eyebrow"><span class="eyebrow-line"></span> THE CRAFT IS IN THE DETAILS</p><h2>Keep learning with <em>every batch.</em></h2><a class="button button-primary" href={base}>Explore both brewing paths <span aria-hidden="true">↗</span></a></div></section>
    </main>
    <footer class="site-footer"><div class="shell footer-main"><a class="wordmark footer-wordmark" href={base}>demleme<span>.</span></a><p>Brewing software in development for people who care about the details.</p><a class="back-top" href={base}>Home ↑</a></div><div class="shell footer-bottom"><span>© {new Date().getFullYear()} Demleme</span><span>Made for the craft of brewing.</span></div></footer>
  </body>
</html>
