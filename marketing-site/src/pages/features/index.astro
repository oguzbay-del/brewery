---
import "../../styles/global.css";
import "../../styles/stitch-layout.css";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { buildBreadcrumbList } from "../../data/breadcrumbs";
import { features } from "../../data/features";

const base = import.meta.env.BASE_URL;
const allowIndexing = new URL(import.meta.env.SITE).hostname === "gristora.com";
const canonicalUrl = new URL(`${base}features/`, import.meta.env.SITE).href;
const description = "Explore GRISTORA’s professional brewery workflows and product capabilities, with a separate Homebrewers path.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Brewery software features — GRISTORA",
  description,
  url: canonicalUrl,
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", name: "GRISTORA", url: new URL(base, import.meta.env.SITE).href },
};
const breadcrumbItems = [{ name: "Home", url: new URL(base, import.meta.env.SITE).href }, { name: "Product", url: canonicalUrl }];
const breadcrumbData = buildBreadcrumbList(breadcrumbItems);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content={description} />
    <title>Brewery Software Features | GRISTORA</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GRISTORA" />
    <meta property="og:title" content="Brewery Software Features | GRISTORA" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Brewery Software Features | GRISTORA" />
    <meta name="twitter:description" content={description} />
    <meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="GRISTORA home"><img class="brand-symbol" src={`${base}brand/gristora-symbol.svg`} alt="" aria-hidden="true" /><span class="wordmark-text">GRISTORA</span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href={`${base}features/`} aria-current={Astro.url.pathname.startsWith(`${base}features/`) ? "page" : undefined}>Product</a>
        <a href={`${base}breweries/`} aria-current={Astro.url.pathname === `${base}breweries/` ? "page" : undefined}>Breweries</a>
        <a href={`${base}homebrewers/`} aria-current={Astro.url.pathname === `${base}homebrewers/` ? "page" : undefined}>Homebrewers</a>
        <a href={`${base}pricing/`}>Pricing</a><a href={`${base}how-it-works/`} aria-current={Astro.url.pathname === `${base}how-it-works/` ? "page" : undefined}>How it works</a>
        <a href={`${base}technical-principles/`} aria-current={Astro.url.pathname === `${base}technical-principles/` ? "page" : undefined}>Principles</a><a href={`${base}faq/`} aria-current={Astro.url.pathname === `${base}faq/` ? "page" : undefined}>FAQ</a>
      </nav>
      <a class="header-cta" href={`${base}breweries/`}>Explore breweries <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu"><summary aria-label="Open navigation menu"><span></span><span></span></summary><nav aria-label="Mobile navigation">
          <a href={`${base}features/`} aria-current={Astro.url.pathname.startsWith(`${base}features/`) ? "page" : undefined}>Product</a>
          <a href={`${base}breweries/`} aria-current={Astro.url.pathname === `${base}breweries/` ? "page" : undefined}>Breweries</a>
          <a href={`${base}homebrewers/`} aria-current={Astro.url.pathname === `${base}homebrewers/` ? "page" : undefined}>Homebrewers</a>
          <a href={`${base}pricing/`}>Pricing</a><a href={`${base}how-it-works/`} aria-current={Astro.url.pathname === `${base}how-it-works/` ? "page" : undefined}>How it works</a>
          <a href={`${base}technical-principles/`} aria-current={Astro.url.pathname === `${base}technical-principles/` ? "page" : undefined}>Technical principles</a><a href={`${base}faq/`} aria-current={Astro.url.pathname === `${base}faq/` ? "page" : undefined}>FAQ</a>
        </nav></details>
    </header>
    <main id="main-content" class="features-page">
      <Breadcrumbs items={breadcrumbItems} />
      <section class="feature-hero shell">
        <p class="eyebrow"><span class="eyebrow-line"></span> THE PRODUCT</p>
        <h1>A connected workspace for <em>professional brewing.</em></h1>
        <p class="feature-lead">GRISTORA is designed first around professional brewery workflows: recipe standards, production planning, batch records and quality context. A distinct Homebrewers path is part of the product.</p>
        <div class="feature-hero-meta"><span>16 product areas</span><span>Business first · Homebrewers path separate</span></div>
      </section>
      <section class="feature-directory section-pad">
        <div class="shell">
          <div class="section-heading feature-section-heading">
            <p class="eyebrow"><span class="eyebrow-line"></span> EXPLORE THE PRODUCT</p>
            <h2>Every part of the brewing workflow has <em>a place.</em></h2>
            <p>Each area has its own page with workflows, detailed capabilities and intended audience.</p>
          </div>
          <div class="feature-card-grid">
            {features.map((feature, index) => (
              <a class="feature-card" href={`${base}features/${feature.slug}/`}>
                <span class="feature-card-index">{String(index + 1).padStart(2, "0")}</span>
                <span class="feature-card-eyebrow">{feature.eyebrow}</span>
                <h2>{feature.title}</h2>
                <p>{feature.summary}</p>
                <span class="feature-card-link">Explore details <span aria-hidden="true">↗</span></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer"><div class="shell footer-main"><a class="wordmark footer-wordmark" href={base}><img class="brand-symbol" src={`${base}brand/gristora-symbol.svg`} alt="" aria-hidden="true" /><span class="wordmark-text">GRISTORA</span></a><p>Brewing software for professional breweries, with a separate Homebrewers path.</p><a class="back-top" href={base}>Home ↑</a></div><div class="shell footer-bottom"><span>© {new Date().getFullYear()} GRISTORA</span><span>Made for the craft of brewing.</span></div></footer>
  </body>
</html>
