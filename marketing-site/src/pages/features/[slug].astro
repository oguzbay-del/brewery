---
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/global.css";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { buildBreadcrumbList } from "../../data/breadcrumbs";
import "../../styles/learning-pages.css";
import "../../styles/faq-evidence.css";
import "../../styles/stitch-layout.css";
import { features } from "../../data/features";

export function getStaticPaths() {
  return features.map((feature) => ({ params: { slug: feature.slug }, props: { feature } }));
}

const { feature } = Astro.props;
const base = import.meta.env.BASE_URL;
const allowIndexing = new URL(import.meta.env.SITE).hostname === "gristora.com";
const canonicalUrl = new URL(`${base}features/${feature.slug}/`, import.meta.env.SITE).href;
const description = feature.summary;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${feature.title} — GRISTORA`,
  description,
  url: canonicalUrl,
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", name: "GRISTORA", url: new URL(base, import.meta.env.SITE).href },
};
const breadcrumbItems = [{ name: "Home", url: new URL(base, import.meta.env.SITE).href }, { name: "Product", url: new URL(`${base}features/`, import.meta.env.SITE).href }, { name: feature.title, url: canonicalUrl }];
const breadcrumbData = buildBreadcrumbList(breadcrumbItems);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content={description} />
    <title>{feature.title} — GRISTORA</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GRISTORA" />
    <meta property="og:title" content={`${feature.title} — GRISTORA`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${feature.title} — GRISTORA`} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader current="product" />
    <main id="main-content" class="feature-detail-page">
      <Breadcrumbs items={breadcrumbItems} />
      <section class="feature-detail-hero shell">
        <p class="eyebrow feature-detail-chip"><span class="eyebrow-line"></span> {feature.eyebrow}</p>
        <h1>{feature.title}</h1>
        <p class="feature-lead">{feature.summary}</p>
        <div class="feature-tags">
          {feature.audiences.map((audience) => <span class="feature-tag">{audience}</span>)}
        </div>
      </section>
      <section class="feature-detail-body section-pad">
        <div class="shell feature-detail-layout">
          <div class="feature-detail-sections">
            {feature.sections.map((section, index) => (
              <section class="feature-detail-section">
                <span class="feature-card-index">{String(index + 1).padStart(2, "0")}</span>
                <div><h2>{section.heading}</h2><p>{section.intro}</p><ul>{section.items.map((item) => <li>{item}</li>)}</ul></div>
              </section>
            ))}
          </div>
          <aside class="feature-roadmap-aside">
            <p class="eyebrow">AUDIENCE</p>
            <p>{feature.audiences.join(" · ")}</p>
          </aside>
        </div>
      </section>
      <section class="feature-evidence-section section-pad">
        <div class="shell feature-evidence-layout">
          <div>
            <p class="eyebrow"><span class="eyebrow-line"></span> INPUTS · RECORDS · OUTPUTS</p>
            <h2>Inputs, records and <em>outputs.</em></h2>
          </div>
          <div class="feature-evidence-content">
            <p><strong>Inputs and records:</strong> Inputs depend on the feature. They include recipe definitions, ingredient and equipment information, measurements, material records or team-entered observations.</p>
            <p><strong>Outputs:</strong> Depending on the feature, outputs include calculations, recipe versions, schedules, batch records, measurement history or review context.</p>
          </div>
        </div>
      </section>
      {feature.note && <section class="feature-caveat"><div class="shell"><p>{feature.note}</p></div></section>}
      <section class="feature-next section-pad">
        <div class="shell feature-next-inner">
          <div><p class="eyebrow"><span class="eyebrow-line"></span> CONTINUE EXPLORING</p><h2>See the complete <em>GRISTORA product.</em></h2></div>
          <div><p>Explore the other product areas or choose the workspace that matches your brewing.</p><a class="button button-primary" href={`${base}features/`}>Browse all product features <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>
    </main>
    <SiteFooter backText="All features ↑" backHref={`${base}features/`} />
  </body>
</html>
