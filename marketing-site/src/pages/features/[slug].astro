---
import "../../styles/global.css";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { buildBreadcrumbList } from "../../data/breadcrumbs";
import "../../styles/learning-pages.css";
import "../../styles/faq-evidence.css";
import { features, stageDescriptions } from "../../data/features";

export function getStaticPaths() {
  return features.map((feature) => ({ params: { slug: feature.slug }, props: { feature } }));
}

const { feature } = Astro.props;
const base = import.meta.env.BASE_URL;
const allowIndexing = new URL(import.meta.env.SITE).hostname === "gristora.com";
const canonicalUrl = new URL(`${base}features/${feature.slug}/`, import.meta.env.SITE).href;
const description = `${feature.summary} GRISTORA is in development.`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${feature.title} — GRISTORA`,
  description,
  url: canonicalUrl,
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", name: "GRISTORA", url: new URL(base, import.meta.env.SITE).href },
};
const breadcrumbItems = [{ name: "Home", url: new URL(base, import.meta.env.SITE).href }, { name: "Product", url: new URL(`${base}features/`, import.meta.env.SITE).href }, { name: feature.title, url: canonicalUrl }];
const breadcrumbData = buildBreadcrumbList(breadcrumbItems);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="robots" content={allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content={description} />
    <title>{feature.title} — GRISTORA</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GRISTORA" />
    <meta property="og:title" content={`${feature.title} — GRISTORA`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${feature.title} — GRISTORA`} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta property="og:image:alt" content="GRISTORA — Brewing Intelligence" />
    <meta name="twitter:image" content={new URL(`${base}social-card.png`, import.meta.env.SITE).href} />
    <meta name="twitter:image:alt" content="GRISTORA — Brewing Intelligence" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="GRISTORA home"><img class="brand-symbol" src={`${base}brand/gristora-symbol.svg`} alt="" aria-hidden="true" /><span class="wordmark-text">GRISTORA</span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href={`${base}features/`} aria-current={Astro.url.pathname.startsWith(`${base}features/`) ? "page" : undefined}>Product</a>
        <a href={`${base}breweries/`} aria-current={Astro.url.pathname === `${base}breweries/` ? "page" : undefined}>Breweries</a>
        <a href={`${base}homebrewers/`} aria-current={Astro.url.pathname === `${base}homebrewers/` ? "page" : undefined}>Homebrewers</a>
        <a href={`${base}how-it-works/`} aria-current={Astro.url.pathname === `${base}how-it-works/` ? "page" : undefined}>How it works</a>
        <a href={`${base}technical-principles/`} aria-current={Astro.url.pathname === `${base}technical-principles/` ? "page" : undefined}>Principles</a><a href={`${base}faq/`} aria-current={Astro.url.pathname === `${base}faq/` ? "page" : undefined}>FAQ</a>
      </nav>
      <a class="header-cta" href={`${base}breweries/`}>Explore breweries <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu"><summary aria-label="Open navigation menu"><span></span><span></span></summary><nav aria-label="Mobile navigation">
          <a href={`${base}features/`} aria-current={Astro.url.pathname.startsWith(`${base}features/`) ? "page" : undefined}>Product</a>
          <a href={`${base}breweries/`} aria-current={Astro.url.pathname === `${base}breweries/` ? "page" : undefined}>Breweries</a>
          <a href={`${base}homebrewers/`} aria-current={Astro.url.pathname === `${base}homebrewers/` ? "page" : undefined}>Homebrewers</a>
          <a href={`${base}how-it-works/`} aria-current={Astro.url.pathname === `${base}how-it-works/` ? "page" : undefined}>How it works</a>
          <a href={`${base}technical-principles/`} aria-current={Astro.url.pathname === `${base}technical-principles/` ? "page" : undefined}>Technical principles</a><a href={`${base}faq/`} aria-current={Astro.url.pathname === `${base}faq/` ? "page" : undefined}>FAQ</a>
        </nav></details>
    </header>
    <main id="main-content">
      <Breadcrumbs items={breadcrumbItems} />
      <section class="feature-detail-hero shell">
        <p class="eyebrow"><span class="eyebrow-line"></span> {feature.eyebrow} · PRODUCT ROADMAP</p>
        <h1>{feature.title}</h1>
        <p class="feature-lead">{feature.summary}</p>
        <div class="feature-tags">
          {feature.audiences.map((audience) => <span class="feature-tag">{audience}</span>)}
          <span class="feature-tag feature-tag-status">Roadmap scope</span>
        </div>
      </section>
      <section class="feature-detail-body section-pad">
        <div class="shell feature-detail-layout">
          <div class="feature-detail-sections">
            {feature.sections.map((section, index) => (
              <section class="feature-detail-section">
                <span class="feature-card-index">{String(index + 1).padStart(2, "0")}</span>
                <div><h2>{section.heading}</h2><p>{section.intro}</p><ul>{section.items.map((item) => <li>{item}</li>)}</ul></div>
              </section>
            ))}
          </div>
          <aside class="feature-roadmap-aside">
            <p class="eyebrow">AUDIENCE</p>
            <p>{feature.audiences.join(" · ")}</p>
            <div class="aside-divider"></div>
            <p class="eyebrow">PLANNED DEVELOPMENT STAGES</p>
            {feature.stages.map((stage) => <div class="stage-item"><strong>{stage}</strong><p>{stageDescriptions[stage]}</p></div>)}
            <div class="aside-divider"></div>
            <p class="feature-aside-note">This is a roadmap description, not a statement that the feature is currently available. Scope and release timing may evolve during development and validation.</p>
          </aside>
        </div>
      </section>
      <section class="feature-evidence-section section-pad">
        <div class="shell feature-evidence-layout">
          <div>
            <p class="eyebrow"><span class="eyebrow-line"></span> INPUTS · RECORDS · LIMITATIONS</p>
            <h2>Understand the intended <em>scope.</em></h2>
          </div>
          <div class="feature-evidence-content">
            <p><strong>Inputs and records:</strong> The intended inputs depend on the feature and release stage. They may include recipe definitions, ingredient and equipment information, measurements, material records or team-entered observations where those workflows are in scope.</p>
            <p><strong>Intended outputs:</strong> Depending on the feature, the roadmap may describe calculations, recipe versions, schedules, batch records, measurement history or review context. This page does not imply that any of those outputs are currently available.</p>
            <p><strong>Limitations:</strong> Formula defaults, supported formats, device compatibility, permissions, regulatory workflows and integrations require feature-specific implementation and validation. Fermentation predictions and model-driven calibration remain under consideration.</p>
            <p><strong>Evidence status:</strong> This description reflects the product roadmap. Public validation reports and release evidence will be added only when the relevant method or workflow has been tested and approved.</p>
          </div>
        </div>
      </section>
      {feature.note && <section class="feature-caveat"><div class="shell"><p>{feature.note}</p></div></section>}
      <section class="feature-next section-pad">
        <div class="shell feature-next-inner">
          <div><p class="eyebrow"><span class="eyebrow-line"></span> CONTINUE EXPLORING</p><h2>See the complete <em>GRISTORA roadmap.</em></h2></div>
          <div><p>Explore the other product areas or choose the workspace that matches your brewing.</p><a class="button button-primary" href={`${base}features/`}>Browse all product features <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>
    </main>
    <footer class="site-footer"><div class="shell footer-main"><a class="wordmark footer-wordmark" href={base}><img class="brand-symbol" src={`${base}brand/gristora-symbol.svg`} alt="" aria-hidden="true" /><span class="wordmark-text">GRISTORA</span></a><p>Brewing software in development for professional breweries, with a separate Homebrewers path.</p><a class="back-top" href={`${base}features/`}>All features ↑</a></div><div class="shell footer-bottom"><span>© {new Date().getFullYear()} GRISTORA</span><span>Made for the craft of brewing.</span></div></footer>
  </body>
</html>
