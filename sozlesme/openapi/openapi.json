{
  "components": {
    "schemas": {
      "ClientRequirements": {
        "description": "Response of `GET /v1/meta/client-requirements`.",
        "properties": {
          "min_ios_version": {
            "description": "Lowest supported iOS version, or `null`.",
            "type": [
              "string",
              "null"
            ]
          },
          "min_web_version": {
            "description": "Lowest supported web build, or `null`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ErrorCode": {
        "description": "Every error code the API returns. The single list: the `OpenAPI` document and the text\ncatalog are generated from it (ADR-0008 rule 3.2).",
        "enum": [
          "malformed_request",
          "unauthenticated",
          "forbidden",
          "step_up_required",
          "entitlement_required",
          "not_found",
          "conflict",
          "idempotency_in_progress",
          "version_mismatch",
          "payload_too_large",
          "unsupported_media_type",
          "validation_failed",
          "idempotency_mismatch",
          "calculation_failed",
          "upgrade_required",
          "precondition_required",
          "rate_limited",
          "internal",
          "unavailable"
        ],
        "type": "string"
      },
      "FieldIssue": {
        "description": "One field-level problem (`errors[]`).",
        "properties": {
          "code": {
            "description": "Stable code of the problem (`out_of_range`, ...).",
            "type": "string"
          },
          "field": {
            "description": "JSON Pointer (RFC 6901) into the request body; a query parameter name for query errors.",
            "type": "string"
          },
          "params": {
            "description": "Parameters for the user text (limits and the like)."
          }
        },
        "required": [
          "field",
          "code"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "description": "Response of `GET /healthz`.",
        "properties": {
          "service": {
            "description": "Service name.",
            "type": "string"
          },
          "status": {
            "description": "Always `\"ok\"` while the process is serving.",
            "type": "string"
          },
          "version": {
            "description": "Service version.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "description": "RFC 9457 problem details body (`application/problem+json`).",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable code clients branch on."
          },
          "current": {
            "description": "Current state of the record (`version_mismatch` only; shape depends on the resource)."
          },
          "errors": {
            "description": "Field-level problems.",
            "items": {
              "$ref": "#/components/schemas/FieldIssue"
            },
            "type": "array"
          },
          "request_id": {
            "description": "Request id (`X-Request-Id`).",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "description": "HTTP status.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "description": "English summary; not shown to end users.",
            "type": "string"
          },
          "type": {
            "description": "Relative address of the problem type (`/errors/<code>`).",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      },
      "ReadyResponse": {
        "description": "Response of `GET /readyz`.",
        "properties": {
          "database": {
            "description": "Database state: `\"ok\"`.",
            "type": "string"
          },
          "redis": {
            "description": "Redis state: `\"ok\"`, `\"unavailable\"` or `\"disabled\"`. Redis loss never fails readiness.",
            "type": "string"
          },
          "status": {
            "description": "`\"ok\"` when the database answers.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "redis"
        ],
        "type": "object"
      },
      "VersionResponse": {
        "description": "Response of `GET /v1/version`.",
        "properties": {
          "api": {
            "description": "API version (the `api` crate version).",
            "type": "string"
          },
          "engine": {
            "description": "Calculation engine version; `null` until the engine is wired in.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "api"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "Opaque session token of the iOS app (ADR-0009)",
        "scheme": "bearer",
        "type": "http"
      },
      "cookie": {
        "description": "Web session cookie (ADR-0009)",
        "in": "cookie",
        "name": "__Host-session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "",
    "license": {
      "name": ""
    },
    "title": "api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health_check",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "service": "api",
                  "status": "ok",
                  "version": "0.1.0"
                },
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service is alive"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "internal": {
                    "summary": "Internal error",
                    "value": {
                      "code": "internal",
                      "request_id": "0192f1c07a3b7000800000000000000a",
                      "status": 500,
                      "title": "Internal error",
                      "type": "/errors/internal"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal error"
          }
        },
        "security": [],
        "summary": "Liveness probe (unversioned).",
        "tags": [
          "system"
        ],
        "x-concurrency": "none",
        "x-permission": "none"
      }
    },
    "/readyz": {
      "get": {
        "operationId": "health_ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "database": "ok",
                  "redis": "ok",
                  "status": "ok"
                },
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Ready to serve"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "internal": {
                    "summary": "Internal error",
                    "value": {
                      "code": "internal",
                      "request_id": "0192f1c07a3b7000800000000000000a",
                      "status": 500,
                      "title": "Internal error",
                      "type": "/errors/internal"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "unavailable": {
                    "summary": "Service unavailable",
                    "value": {
                      "code": "unavailable",
                      "request_id": "0192f1c07a3b7000800000000000000a",
                      "status": 503,
                      "title": "Service unavailable",
                      "type": "/errors/unavailable"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service unavailable",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [],
        "summary": "Readiness probe (unversioned): the database must answer.",
        "tags": [
          "system"
        ],
        "x-concurrency": "none",
        "x-permission": "none"
      }
    },
