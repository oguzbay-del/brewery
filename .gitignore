ios/*.xcodeproj/
ios/DerivedData/
ios/xcuserdata/

# web
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/

# sozlesme: üretilen TypeScript tipleri depoda tutulur

# altyapi/compose: yerel geçersiz kılmalar
altyapi/compose/.env
# Terraform: yerel durum ve gerçek değişkenler (kilit dosyaları depoda kalır)
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars
crash.log
